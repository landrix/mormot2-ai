# Externe Konzept-Klone (read-only, nur lokal) - reine Nachschlagequelle.
/_upstream/

# Evaluations-Klone (z.B. flydev mormot-mcp-server) - zum Pruefen, nicht eingecheckt.
/_eval/

# Interne Clean-Room-Prozess-/Provenance-Doku - bewusst NICHT eingecheckt.
/_cleanroom/

# Lokale Secrets/Provider-Konfig fuer die Demos (API-Keys) - NIE einchecken.
.env
demos/.env

# GGUF-Embedding-Modelle (gross, maschinenlokal) - nie einchecken, per Pfad referenzieren.
/vendor/models/
*.gguf

# SQLite-Extension-Binaries (vec0/lembed0, .so/.dll je Arch) - lokal beschaffen.
/vendor/sqlite-ext/

# FPC/Lazarus-Build-Artefakte (Compiler-Output + Unit-Cache + Demo-/Test-Binaries)
/bin/
*.o
*.ppu
*.compiled
*.bak
