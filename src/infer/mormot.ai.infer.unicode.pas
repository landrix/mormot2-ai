/// native inference engine - Unicode code points, classes and NFC
// - part of the mormot.ai.* extension (LandrixAI)
// - licensed under a MPL/GPL/LGPL three license - see LICENSE
// - the tables (mormot.ai.infer.unicode.inc) are generated by
//   tools/infer-ref/make_reference_qwen3.py and measured against the Hugging
//   Face tokenizer of Qwen2/Qwen3: the code point classes of its pre-tokenizer
//   regex (\p{L}, \p{N}, \s) and its NFC normalizer - which uses older Unicode
//   data than current Python, so the tables follow the tokenizer, not the
//   newest Unicode version
// - a second class table (mormot.ai.infer.unicode.o200k.inc, written by
//   tools/infer-ref/make_reference_d5c.py) splits the letters the way the
//   o200k pre-tokenizer of gpt-oss needs them: upper and title case, lower
//   case, modifier and other letters, and the marks; measured with the same
//   regex engine, its letters, numbers and white space are those of the first
// - NFC is the algorithm of UAX #15: full canonical decomposition (Hangul
//   algorithmic), canonical ordering, canonical composition of primary
//   composites with the blocking rules
// - thread-safe: only constant tables and local state
unit mormot.ai.infer.unicode;

{
  *****************************************************************************

    - Utf8ToCodePoints / CodePointsToUtf8: UTF-8 decoding with U+FFFD
    - UnicodeClassOf: letter, number, white space or other
    - O200kClassOf: the finer classes of the o200k pre-tokenizer
    - NfcCodePoints / NfcNormalize: Unicode normalization form C

  *****************************************************************************
}

interface

{$I mormot.defines.inc}

{$ifndef FPC}{$ifdef CPUX64}
  {$EXCESSPRECISION OFF} // single expressions in single, as FPC computes them
{$endif}{$endif}

uses
  mormot.core.base;

type
  /// the class of a code point, as the pre-tokenizer regex sees it
  TUnicodeClass = (
    ucOther,
    ucLetter,
    ucNumber,
    ucSpace);

  /// the class of a code point, as the o200k pre-tokenizer regex of gpt-oss
  // sees it: [\p{Lu}\p{Lt}\p{Lm}\p{Lo}\p{M}] are ocUpper, ocLetter and ocMark,
  // [\p{Ll}\p{Lm}\p{Lo}\p{M}] are ocLower, ocLetter and ocMark, \p{L} are
  // ocUpper, ocLower and ocLetter (a mark is no letter)
  TO200kClass = (
    ocOther,
    ocUpper,
    ocLower,
    ocLetter,
    ocMark,
    ocNumber,
    ocSpace);

const
  /// U+FFFD REPLACEMENT CHARACTER
  UNICODE_REPLACEMENT = $fffd;

/// decode UTF-8 into code points
// - an invalid or truncated sequence, an overlong form, a surrogate or a value
// above U+10FFFF becomes U+FFFD, one per invalid byte (as SentencePiece does)
// - returns the number of code points stored in aCp (its length may be more)
function Utf8ToCodePoints(p: PUtf8Char; aLen: PtrInt;
  var aCp: TCardinalDynArray): PtrInt;

/// encode code points as UTF-8
function CodePointsToUtf8(aCp: PCardinalArray; aCount: PtrInt): RawUtf8;

/// encode code points as UTF-8 into aDest (room for 4 * aCount bytes)
// - returns the number of bytes written
function CodePointsToUtf8Buffer(aCp: PCardinalArray; aCount: PtrInt;
  aDest: PByteArray): PtrInt;

/// true when aLen bytes at p are well-formed UTF-8: no overlong form, no
// surrogate, nothing above U+10FFFF, no truncated sequence - U+0000 allowed
// - the same rules as Utf8ToCodePoints, on every platform (mORMot's
// IsValidUtf8 differs between its Pascal and AVX2 paths)
function IsStrictUtf8(p: PUtf8Char; aLen: PtrInt): boolean;

/// the class of a code point, as the Qwen2 pre-tokenizer regex sees it
function UnicodeClassOf(aCp: cardinal): TUnicodeClass;

/// the class of a code point, as the o200k pre-tokenizer regex sees it
function O200kClassOf(aCp: cardinal): TO200kClass;

/// the canonical combining class of a code point (0 for a starter)
function CombiningClassOf(aCp: cardinal): byte;

/// normalize code points to NFC, in place
// - aCount is updated; aCp may be reallocated (decomposition can grow it)
procedure NfcCodePoints(var aCp: TCardinalDynArray; var aCount: PtrInt);

/// normalize UTF-8 text to NFC - invalid UTF-8 becomes U+FFFD first
function NfcNormalize(const aText: RawUtf8): RawUtf8;


implementation

{$I mormot.ai.infer.unicode.inc}
{$I mormot.ai.infer.unicode.o200k.inc}

var
  /// the class of the 128 ASCII code points, from the same tables
  AsciiClass: array[0..127] of TUnicodeClass;
  AsciiO200k: array[0..127] of TO200kClass;

function Utf8ToCodePoints(p: PUtf8Char; aLen: PtrInt;
  var aCp: TCardinalDynArray): PtrInt;
var
  b: PByteArray;
  i, n, k: PtrInt;
  c, cp: cardinal;
  valid: boolean;
begin
  if length(aCp) < aLen then
    SetLength(aCp, aLen); // never more code points than bytes
  b := pointer(p);
  i := 0;
  result := 0;
  while i < aLen do
  begin
    c := b^[i];
    if c < $80 then
    begin
      aCp[result] := c;
      inc(result);
      inc(i);
      continue;
    end;
    if c and $e0 = $c0 then
    begin
      n := 2;
      cp := c and $1f;
    end
    else if c and $f0 = $e0 then
    begin
      n := 3;
      cp := c and $0f;
    end
    else if c and $f8 = $f0 then
    begin
      n := 4;
      cp := c and $07;
    end
    else
    begin
      n := 0;
      cp := 0;
    end;
    valid := (n > 0) and (i + n <= aLen);
    if valid then
      for k := 1 to n - 1 do
        if b^[i + k] and $c0 <> $80 then
        begin
          valid := false;
          break;
        end
        else
          cp := (cp shl 6) or (b^[i + k] and $3f);
    if valid then
      case n of
        2:
          valid := cp >= $80;
        3:
          valid := (cp >= $800) and ((cp < $d800) or (cp > $dfff));
        4:
          valid := (cp >= $10000) and (cp <= $10ffff);
      end;
    if valid then
    begin
      aCp[result] := cp;
      inc(i, n);
    end
    else
    begin
      aCp[result] := UNICODE_REPLACEMENT;
      inc(i);
    end;
    inc(result);
  end;
end;

function IsStrictUtf8(p: PUtf8Char; aLen: PtrInt): boolean;
var
  b: PByteArray;
  i, n, k: PtrInt;
  c, cp: cardinal;
begin
  result := false;
  n := 0; // (Delphi 7 cannot see that every path below sets them)
  cp := 0;
  b := pointer(p);
  i := 0;
  while i < aLen do
  begin
    c := b^[i];
    if c < $80 then
    begin
      inc(i);
      continue;
    end;
    if c and $e0 = $c0 then
    begin
      n := 2;
      cp := c and $1f;
    end
    else if c and $f0 = $e0 then
    begin
      n := 3;
      cp := c and $0f;
    end
    else if c and $f8 = $f0 then
    begin
      n := 4;
      cp := c and $07;
    end
    else
      exit;
    if i + n > aLen then
      exit;
    for k := 1 to n - 1 do
      if b^[i + k] and $c0 <> $80 then
        exit
      else
        cp := (cp shl 6) or (b^[i + k] and $3f);
    case n of
      2:
        if cp < $80 then
          exit;
      3:
        if (cp < $800) or ((cp >= $d800) and (cp <= $dfff)) then
          exit;
      4:
        if (cp < $10000) or (cp > $10ffff) then
          exit;
    end;
    inc(i, n);
  end;
  result := true;
end;

function CodePointsToUtf8Buffer(aCp: PCardinalArray; aCount: PtrInt;
  aDest: PByteArray): PtrInt;
var
  i: PtrInt;
  c: cardinal;
begin
  result := 0;
  for i := 0 to aCount - 1 do
  begin
    c := aCp^[i];
    if c < $80 then
    begin
      aDest^[result] := c;
      inc(result);
    end
    else if c < $800 then
    begin
      aDest^[result] := $c0 or (c shr 6);
      aDest^[result + 1] := $80 or (c and $3f);
      inc(result, 2);
    end
    else if c < $10000 then
    begin
      aDest^[result] := $e0 or (c shr 12);
      aDest^[result + 1] := $80 or ((c shr 6) and $3f);
      aDest^[result + 2] := $80 or (c and $3f);
      inc(result, 3);
    end
    else
    begin
      aDest^[result] := $f0 or (c shr 18);
      aDest^[result + 1] := $80 or ((c shr 12) and $3f);
      aDest^[result + 2] := $80 or ((c shr 6) and $3f);
      aDest^[result + 3] := $80 or (c and $3f);
      inc(result, 4);
    end;
  end;
end;

function CodePointsToUtf8(aCp: PCardinalArray; aCount: PtrInt): RawUtf8;
var
  i, n: PtrInt;
  c: cardinal;
  d: PByteArray;
begin
  n := 0;
  for i := 0 to aCount - 1 do
  begin
    c := aCp^[i];
    if c < $80 then
      inc(n)
    else if c < $800 then
      inc(n, 2)
    else if c < $10000 then
      inc(n, 3)
    else
      inc(n, 4);
  end;
  FastSetString(result, n);
  d := pointer(result);
  n := 0;
  for i := 0 to aCount - 1 do
  begin
    c := aCp^[i];
    if c < $80 then
    begin
      d^[n] := c;
      inc(n);
    end
    else if c < $800 then
    begin
      d^[n] := $c0 or (c shr 6);
      d^[n + 1] := $80 or (c and $3f);
      inc(n, 2);
    end
    else if c < $10000 then
    begin
      d^[n] := $e0 or (c shr 12);
      d^[n + 1] := $80 or ((c shr 6) and $3f);
      d^[n + 2] := $80 or (c and $3f);
      inc(n, 3);
    end
    else
    begin
      d^[n] := $f0 or (c shr 18);
      d^[n + 1] := $80 or ((c shr 12) and $3f);
      d^[n + 2] := $80 or ((c shr 6) and $3f);
      d^[n + 3] := $80 or (c and $3f);
      inc(n, 4);
    end;
  end;
end;

/// index of the range holding aCp in sorted, disjoint [aLo..aHi] ranges, or -1
function FindRange(aCp: cardinal; aLo, aHi: PCardinalArray; aCount: PtrInt): PtrInt;
var
  l, h, m: PtrInt;
begin
  l := 0;
  h := aCount - 1;
  while l <= h do
  begin
    m := (l + h) shr 1;
    if aCp < aLo^[m] then
      h := m - 1
    else if aCp > aHi^[m] then
      l := m + 1
    else
    begin
      result := m;
      exit;
    end;
  end;
  result := -1;
end;

function UnicodeClassOf(aCp: cardinal): TUnicodeClass;
var
  i: PtrInt;
begin
  if aCp < 128 then
  begin
    result := AsciiClass[aCp];
    exit;
  end;
  i := FindRange(aCp, @UNI_CLASS_LO, @UNI_CLASS_HI, UNI_CLASS_COUNT);
  if i < 0 then
    result := ucOther
  else
    result := TUnicodeClass(UNI_CLASS_KIND[i]);
end;

function O200kClassOf(aCp: cardinal): TO200kClass;
var
  i: PtrInt;
begin
  if aCp < 128 then
  begin
    result := AsciiO200k[aCp];
    exit;
  end;
  i := FindRange(aCp, @UNI_O200K_LO, @UNI_O200K_HI, UNI_O200K_COUNT);
  if i < 0 then
    result := ocOther
  else
    result := TO200kClass(UNI_O200K_KIND[i]);
end;

function CombiningClassOf(aCp: cardinal): byte;
var
  i: PtrInt;
begin
  result := 0;
  if aCp < UNI_CCC_LO[0] then
    exit;
  i := FindRange(aCp, @UNI_CCC_LO, @UNI_CCC_HI, UNI_CCC_COUNT);
  if i >= 0 then
    result := UNI_CCC_VALUE[i];
end;

/// index of aCp in UNI_DECOMP_CP, or -1
function FindDecomposition(aCp: cardinal): PtrInt;
var
  l, h, m: PtrInt;
begin
  l := 0;
  h := UNI_DECOMP_COUNT - 1;
  while l <= h do
  begin
    m := (l + h) shr 1;
    if aCp < UNI_DECOMP_CP[m] then
      h := m - 1
    else if aCp > UNI_DECOMP_CP[m] then
      l := m + 1
    else
    begin
      result := m;
      exit;
    end;
  end;
  result := -1;
end;

/// the primary composite of aFirst + aSecond, or 0
function FindComposition(aFirst, aSecond: cardinal): cardinal;
var
  l, h, m: PtrInt;
begin
  l := 0;
  h := UNI_COMP_COUNT - 1;
  while l <= h do
  begin
    m := (l + h) shr 1;
    if (aFirst < UNI_COMP_FIRST[m]) or
       ((aFirst = UNI_COMP_FIRST[m]) and (aSecond < UNI_COMP_SECOND[m])) then
      h := m - 1
    else if (aFirst > UNI_COMP_FIRST[m]) or (aSecond > UNI_COMP_SECOND[m]) then
      l := m + 1
    else
    begin
      result := UNI_COMP_RESULT[m];
      exit;
    end;
  end;
  result := 0;
end;

const
  // Hangul syllable arithmetic (UAX #15, Unicode chapter 3.12)
  HANGUL_SBASE = $ac00;
  HANGUL_LBASE = $1100;
  HANGUL_VBASE = $1161;
  HANGUL_TBASE = $11a7;
  HANGUL_LCOUNT = 19;
  HANGUL_VCOUNT = 21;
  HANGUL_TCOUNT = 28;
  HANGUL_NCOUNT = HANGUL_VCOUNT * HANGUL_TCOUNT;
  HANGUL_SCOUNT = HANGUL_LCOUNT * HANGUL_NCOUNT;

procedure NfcCodePoints(var aCp: TCardinalDynArray; var aCount: PtrInt);
var
  d, tmp: TCardinalDynArray;
  dn, i, j, k, idx, first, last, starter, rn: PtrInt;
  counts: array[byte] of PtrInt;
  cp, c, s0, composed, lastCcc, t: cardinal;
  quick: boolean;
begin
  // quick path: no code point that decomposes, reorders or composes
  // (UNI_NFC_QUICK_LIMIT is computed by the generator from the same tables)
  quick := true;
  for i := 0 to aCount - 1 do
    if aCp[i] >= UNI_NFC_QUICK_LIMIT then
    begin
      quick := false;
      break;
    end;
  if quick then
    exit;
  // 1. full canonical decomposition
  SetLength(d, aCount * 4 + 4);
  dn := 0;
  for i := 0 to aCount - 1 do
  begin
    cp := aCp[i];
    if dn + 4 > length(d) then
      SetLength(d, length(d) * 2);
    if (cp >= HANGUL_SBASE) and (cp < HANGUL_SBASE + HANGUL_SCOUNT) then
    begin
      t := cp - HANGUL_SBASE;
      d[dn] := HANGUL_LBASE + t div HANGUL_NCOUNT;
      d[dn + 1] := HANGUL_VBASE + (t mod HANGUL_NCOUNT) div HANGUL_TCOUNT;
      inc(dn, 2);
      if t mod HANGUL_TCOUNT <> 0 then
      begin
        d[dn] := HANGUL_TBASE + t mod HANGUL_TCOUNT;
        inc(dn);
      end;
      continue;
    end;
    idx := -1;
    if cp >= UNI_DECOMP_CP[0] then
      idx := FindDecomposition(cp);
    if idx < 0 then
    begin
      d[dn] := cp;
      inc(dn);
      continue;
    end;
    first := UNI_DECOMP_OFS[idx];
    last := UNI_DECOMP_OFS[idx + 1];
    if dn + last - first > length(d) then
      SetLength(d, length(d) * 2 + last - first);
    for j := first to last - 1 do
    begin
      d[dn] := UNI_DECOMP_DATA[j];
      inc(dn);
    end;
  end;
  // 2. canonical ordering: stable sort of each run of non-starters by class -
  // insertion for short runs, counting sort for long ones (a hostile run of
  // thousands of marks must not cost quadratic time)
  i := 0;
  while i < dn do
  begin
    if CombiningClassOf(d[i]) = 0 then
    begin
      inc(i);
      continue;
    end;
    j := i;
    while (j < dn) and (CombiningClassOf(d[j]) <> 0) do
      inc(j);
    if j - i <= 32 then
      for k := i + 1 to j - 1 do
      begin
        cp := d[k];
        c := CombiningClassOf(cp);
        idx := k - 1;
        while (idx >= i) and (CombiningClassOf(d[idx]) > c) do
        begin
          d[idx + 1] := d[idx];
          dec(idx);
        end;
        d[idx + 1] := cp;
      end
    else
    begin
      FillCharFast(counts, SizeOf(counts), 0);
      for k := i to j - 1 do
        inc(counts[CombiningClassOf(d[k])]);
      idx := 0;
      for k := 0 to 255 do
      begin
        first := counts[k];
        counts[k] := idx;
        inc(idx, first);
      end;
      if length(tmp) < j - i then
        SetLength(tmp, j - i);
      for k := i to j - 1 do
      begin
        c := CombiningClassOf(d[k]);
        tmp[counts[c]] := d[k];
        inc(counts[c]);
      end;
      MoveFast(tmp[0], d[i], (j - i) * SizeOf(cardinal));
    end;
    i := j;
  end;
  // 3. canonical composition, written back into aCp
  if length(aCp) < dn then
    SetLength(aCp, dn);
  rn := 0;
  if dn > 0 then
  begin
    aCp[0] := d[0];
    rn := 1;
    if CombiningClassOf(d[0]) = 0 then
    begin
      starter := 0;
      lastCcc := 0;
    end
    else
    begin
      starter := -1;
      lastCcc := 256;
    end;
    for i := 1 to dn - 1 do
    begin
      cp := d[i];
      c := CombiningClassOf(cp);
      if starter >= 0 then
      begin
        s0 := aCp[starter];
        composed := 0;
        if (s0 >= HANGUL_LBASE) and (s0 < HANGUL_LBASE + HANGUL_LCOUNT) and
           (cp >= HANGUL_VBASE) and (cp < HANGUL_VBASE + HANGUL_VCOUNT) and
           (starter = rn - 1) then
          composed := HANGUL_SBASE +
            ((s0 - HANGUL_LBASE) * HANGUL_VCOUNT + (cp - HANGUL_VBASE)) * HANGUL_TCOUNT
        else if (s0 >= HANGUL_SBASE) and (s0 < HANGUL_SBASE + HANGUL_SCOUNT) and
           ((s0 - HANGUL_SBASE) mod HANGUL_TCOUNT = 0) and
           (cp > HANGUL_TBASE) and (cp < HANGUL_TBASE + HANGUL_TCOUNT) and
           (starter = rn - 1) then
          composed := s0 + cp - HANGUL_TBASE
        else if (lastCcc < c) or ((lastCcc = 0) and (starter = rn - 1)) then
          composed := FindComposition(s0, cp);
        if composed <> 0 then
        begin
          aCp[starter] := composed;
          continue;
        end;
      end;
      if c = 0 then
      begin
        starter := rn;
        lastCcc := 0;
      end
      else
        lastCcc := c;
      aCp[rn] := cp;
      inc(rn);
    end;
  end;
  aCount := rn;
end;

function NfcNormalize(const aText: RawUtf8): RawUtf8;
var
  cp: TCardinalDynArray;
  n: PtrInt;
begin
  n := Utf8ToCodePoints(pointer(aText), length(aText), cp);
  NfcCodePoints(cp, n);
  result := CodePointsToUtf8(pointer(cp), n);
end;

procedure InitAscii;
var
  c: PtrInt;
  i: PtrInt;
begin
  for c := 0 to 127 do
  begin
    i := FindRange(c, @UNI_CLASS_LO, @UNI_CLASS_HI, UNI_CLASS_COUNT);
    if i < 0 then
      AsciiClass[c] := ucOther
    else
      AsciiClass[c] := TUnicodeClass(UNI_CLASS_KIND[i]);
    i := FindRange(c, @UNI_O200K_LO, @UNI_O200K_HI, UNI_O200K_COUNT);
    if i < 0 then
      AsciiO200k[c] := ocOther
    else
      AsciiO200k[c] := TO200kClass(UNI_O200K_KIND[i]);
  end;
end;


initialization
  InitAscii;

end.
