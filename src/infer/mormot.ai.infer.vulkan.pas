      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DestroyPipelineLayout: procedure(aDevice: TVkDispatch; aLayout: TVkHandle;
      aAlloc: pointer);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CreateComputePipelines: function(aDevice: TVkDispatch; aCache: TVkHandle;
      aCount: cardinal; aInfos: pointer; aAlloc: pointer;
      aPipelines: PVkHandle): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DestroyPipeline: procedure(aDevice: TVkDispatch; aPipeline: TVkHandle;
      aAlloc: pointer);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CreateDescriptorPool: function(aDevice: TVkDispatch; aInfo: pointer;
      aAlloc: pointer; var aPool: TVkHandle): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DestroyDescriptorPool: procedure(aDevice: TVkDispatch; aPool: TVkHandle;
      aAlloc: pointer);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    ResetDescriptorPool: function(aDevice: TVkDispatch; aPool: TVkHandle;
      aFlags: TVkFlags): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    AllocateDescriptorSets: function(aDevice: TVkDispatch; aInfo: pointer;
      aSets: PVkHandle): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    UpdateDescriptorSets: procedure(aDevice: TVkDispatch; aWriteCount: cardinal;
      aWrites: pointer; aCopyCount: cardinal; aCopies: pointer);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CreateCommandPool: function(aDevice: TVkDispatch; aInfo: pointer; aAlloc: pointer;
      var aPool: TVkHandle): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DestroyCommandPool: procedure(aDevice: TVkDispatch; aPool: TVkHandle;
      aAlloc: pointer);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    AllocateCommandBuffers: function(aDevice: TVkDispatch; aInfo: pointer;
      aBuffers: pointer): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    BeginCommandBuffer: function(aBuffer: TVkDispatch; aInfo: pointer): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    EndCommandBuffer: function(aBuffer: TVkDispatch): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    ResetCommandBuffer: function(aBuffer: TVkDispatch; aFlags: TVkFlags): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CmdBindPipeline: procedure(aBuffer: TVkDispatch; aBindPoint: integer;
      aPipeline: TVkHandle);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CmdBindDescriptorSets: procedure(aBuffer: TVkDispatch; aBindPoint: integer;
      aLayout: TVkHandle; aFirstSet, aSetCount: cardinal; aSets: PVkHandle;
      aDynamicCount: cardinal; aDynamic: pointer);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CmdPushConstants: procedure(aBuffer: TVkDispatch; aLayout: TVkHandle;
      aStages: TVkFlags; aOffset, aSize: cardinal; aValues: pointer);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CmdDispatch: procedure(aBuffer: TVkDispatch; aX, aY, aZ: cardinal);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CmdCopyBuffer: procedure(aBuffer: TVkDispatch; aSrc, aDst: TVkHandle;
      aCount: cardinal; aRegions: pointer);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CmdPipelineBarrier: procedure(aBuffer: TVkDispatch; aSrcStages, aDstStages,
      aDependency: TVkFlags; aMemoryCount: cardinal; aMemory: pointer;
      aBufferCount: cardinal; aBuffers: pointer; aImageCount: cardinal;
      aImages: pointer);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CreateQueryPool: function(aDevice: TVkDispatch; aInfo: pointer; aAlloc: pointer;
      var aPool: TVkHandle): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DestroyQueryPool: procedure(aDevice: TVkDispatch; aPool: TVkHandle;
      aAlloc: pointer);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    GetQueryPoolResults: function(aDevice: TVkDispatch; aPool: TVkHandle;
      aFirst, aCount: cardinal; aDataSize: PtrUInt; aData: pointer;
      aStride: TVkDeviceSize; aFlags: TVkFlags): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CmdResetQueryPool: procedure(aBuffer: TVkDispatch; aPool: TVkHandle;
      aFirst, aCount: cardinal);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CmdWriteTimestamp: procedure(aBuffer: TVkDispatch; aStage: TVkFlags;
      aPool: TVkHandle; aQuery: cardinal);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    QueueSubmit: function(aQueue: TVkDispatch; aCount: cardinal; aSubmits: pointer;
      aFence: TVkHandle): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CreateFence: function(aDevice: TVkDispatch; aInfo: pointer; aAlloc: pointer;
      var aFence: TVkHandle): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DestroyFence: procedure(aDevice: TVkDispatch; aFence: TVkHandle; aAlloc: pointer);
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    WaitForFences: function(aDevice: TVkDispatch; aCount: cardinal; aFences: PVkHandle;
      aWaitAll: TVkBool32; aTimeout: Int64): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    ResetFences: function(aDevice: TVkDispatch; aCount: cardinal;
      aFences: PVkHandle): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DeviceWaitIdle: function(aDevice: TVkDispatch): TVkResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
  end;

  /// one Vulkan device with a compute queue: the context of the GPU backend
  // - Create picks a discrete GPU before an integrated one, before a virtual
  // one, before a CPU implementation (lavapipe); LAI_VULKAN_DEVICE=<index>
  // picks one by its index in vkEnumeratePhysicalDevices
  // - one Run at a time: the caller serializes (the backend holds a lock)
  TInferVulkan = class
  protected
    fLib: TLibHandle;
    fApi: TInferVkApi;
    fInstance, fPhysical, fDevice, fQueue, fCmd: TVkDispatch;
    fFamily: cardinal;
    fCmdPool, fFence: TVkHandle;
    fMemory: TVkPhysicalDeviceMemoryProperties;
    fDeviceName: RawUtf8;
    fDeviceType, fVendorId: integer;
    fMaxStorageRange, fMaxInvocations, fMaxGroupSizeX, fMaxSharedMemory: cardinal;
    fMinStorageAlign: TVkDeviceSize;
    fApiVersion, fSubgroupSize, fSubgroupStages, fSubgroupOperations: cardinal;
    fPortability: boolean;
    // a Run whose work may still be pending on the device (its wait failed):
    // the command buffer and descriptor sets must not be touched any more
    fBroken: boolean;
    // the host-visible buffer of Upload / Download to device memory
    fStaging: TInferVkBuffer;
    // the descriptor sets of a batch: one per dispatch, the pool reset at
    // BatchBegin; fBatching while a batch is being recorded
    fBatchPool: TVkHandle;
    fBatchSets, fBatchMax: integer;
    fBatching: boolean;
    // the command buffers of a batch: fCmd is fCmds[fCmdIndex]; BatchFlush
    // submits the current one without a fence (fFlushed) and goes on in the next
    fCmds: array of TVkDispatch;
    fCmdIndex: integer;
    fFlushed: boolean;
    // fCmd is between vkBeginCommandBuffer and vkEndCommandBuffer
    fRecording: boolean;
    // profiling: a timestamp after every operation of a batch, summed per name
    fProfile, fProfiling: boolean;
    fTimestampBits: cardinal;
    fTimestampPeriod: single;
    // a portability device stamped two operations with the same tick:
    // HasTimestamps is false from then on
    fTimestampsFlat: boolean;
    fQueryPool: TVkHandle;
    fQueries: integer;
    fQueryTag: TRawUtf8DynArray;
    fProfName: TRawUtf8DynArray;
    fRecordStart: Int64;
    fRecordUs, fWaitUs, fBatches: Int64;
    fProfNs, fProfCount: TInt64DynArray;
    procedure Stamp(const aTag: RawUtf8);
    procedure Collect;
    procedure Check(aResult: TVkResult; const aCall: RawUtf8);
    // a failed vkCreate*/vkAllocate*/vkMap* leaves its output undefined: reset
    // it, so that the destructor does not release what was never created
    procedure CheckNew(aResult: TVkResult; var aHandle: TVkHandle;
      const aCall: RawUtf8); overload;
    procedure CheckNew(aResult: TVkResult; var aPointer: pointer;
      const aCall: RawUtf8); overload;
    procedure Load(var aProc; aName: PAnsiChar; aFromDevice: boolean);
    function MemoryType(aBits: cardinal; aFlags: TVkFlags): integer;
    function TryMemoryType(aBits: cardinal; aFlags: TVkFlags): integer;
    procedure Open;
    procedure Close;
    // one command buffer: reset and begin (after a barrier that makes every
    // earlier device write visible), then end, submit and wait (after a
    // barrier that makes the writes visible to the host)
    procedure CmdBegin;
    procedure CmdSubmit;
    procedure DoRun(aPipeline: TInferVkPipeline;
      const aBuffers: array of TInferVkBuffer; aPush: pointer;
      aX, aY, aZ: cardinal);
    procedure DoCopy(aUp: boolean; aBuffer: TInferVkBuffer;
      aOffset: TVkDeviceSize; aHost: PByte; aBytes: TVkDeviceSize);
    // aOffsets, aRanges: nil binds every buffer whole, else per buffer a byte
    // offset and range (a range of 0: the whole buffer)
    procedure Bind(aPipeline: TInferVkPipeline; aSet: TVkHandle;
      const aBuffers: array of TInferVkBuffer; aOffsets, aRanges: PInt64Array);
    procedure Barrier;
    procedure SetBatchMax(aValue: integer);
    procedure DoBatchBegin;
    procedure DoBatchDispatch(aPipeline: TInferVkPipeline;
      const aBuffers: array of TInferVkBuffer; aOffsets, aRanges: PInt64Array;
      aPush: pointer; aX, aY, aZ: cardinal; aBarrier: boolean);
  public
    /// load the loader, create an instance and a device; raises EInferVulkan
    // when any step fails (no loader, no device, no compute queue)
    constructor Create;
    destructor Destroy; override;
    /// true when a TInferVulkan can be created here (tried once, then cached)
    class function Available: boolean;
    /// run aPipeline once: bind aBuffers (in binding order), push aPush
    // (aPipeline.PushSize bytes), dispatch aX * aY * aZ work groups, wait
    procedure Run(aPipeline: TInferVkPipeline;
      const aBuffers: array of TInferVkBuffer; aPush: pointer;
      aX: cardinal; aY: cardinal = 1; aZ: cardinal = 1);
    /// copy aBytes from aSource into aBuffer at aOffset (directly when the
    // buffer is mapped, else through the staging buffer), waiting until done
    procedure Upload(aBuffer: TInferVkBuffer; aOffset: TVkDeviceSize;
      aSource: pointer; aBytes: TVkDeviceSize);
    /// copy aBytes of aBuffer at aOffset to aDest, waiting until done
    procedure Download(aBuffer: TInferVkBuffer; aOffset: TVkDeviceSize;
      aDest: pointer; aBytes: TVkDeviceSize);
    /// start recording a batch: dispatches and copies, each after the previous
    // one (a barrier between them), submitted at once by BatchSubmit - one
    // wait for a whole forward pass instead of one per operation
    // - no Run, Upload or Download until BatchSubmit; host writes to mapped
    // buffers made before BatchSubmit are seen by the batch
    procedure BatchBegin;
    /// record aPipeline on aBuffers (see Run) into the batch
    // - aBarrier = false: the next operation may run alongside this one - only
    // when it neither reads what this one writes nor writes what it touches
    procedure BatchDispatch(aPipeline: TInferVkPipeline;
      const aBuffers: array of TInferVkBuffer; aPush: pointer;
      aX: cardinal; aY: cardinal = 1; aZ: cardinal = 1; aBarrier: boolean = true);
    /// BatchDispatch binding a part of each buffer: aRanges[i] bytes from
    // aOffsets[i] (a multiple of MinStorageAlignment, the range at most
    // MaxStorageRange), or the whole buffer when aRanges[i] = 0 - e.g. one
    // expert of a buffer which holds all experts of a layer
    procedure BatchDispatchAt(aPipeline: TInferVkPipeline;
      const aBuffers: array of TInferVkBuffer; const aOffsets, aRanges: array of Int64;
      aPush: pointer; aX: cardinal; aY: cardinal = 1; aZ: cardinal = 1;
      aBarrier: boolean = true);
    /// record a copy of aBytes from aSrc at aSrcOffset to aDst at aDstOffset
    procedure BatchCopy(aSrc: TInferVkBuffer; aSrcOffset: TVkDeviceSize;
      aDst: TInferVkBuffer; aDstOffset: TVkDeviceSize; aBytes: TVkDeviceSize);
    /// record a copy of aRows rows of aBytes: row i from aSrc at aSrcOffset +
    // i * aSrcStride to aDst at aDstOffset + i * aDstStride - one command,
    // one barrier
    procedure BatchCopyRows(aSrc: TInferVkBuffer; aSrcOffset, aSrcStride: TVkDeviceSize;
      aDst: TInferVkBuffer; aDstOffset, aDstStride: TVkDeviceSize;
      aBytes: TVkDeviceSize; aRows: PtrInt);
    /// submit what the batch recorded so far, without waiting, and go on
    // recording: the device works while the host records the rest (one forward
    // pass of a decoded token: the device would otherwise idle while all of it
    // is recorded) - the next operation still sees every write before; a
    // no-op once the batch has used all its command buffers (8)
    procedure BatchFlush;
    /// submit the batch and wait: its writes are then visible to the host
    procedure BatchSubmit;
    /// leave a batch without submitting it (after an exception while recording)
    procedure BatchAbort;
    /// how many more dispatches the batch being recorded takes (BatchMaxSets
    // less those recorded): a caller with an unknown number of dispatches
    // ahead submits and begins a new batch when this runs low
    function BatchRoom: integer;
    /// the dispatches of one batch at most: VK_BATCH_SETS (4096, the size of
    // the descriptor pool) by default - lower, at least 16, for tests of
    // callers which split their batches by BatchRoom (TQwen3Vulkan needs room
    // for a layer, and for its head: the norm and every part of it)
    property BatchMaxSets: integer read fBatchMax write SetBatchMax;
    property Api: TInferVkApi read fApi;
    property Device: TVkDispatch read fDevice;
    /// VkPhysicalDeviceProperties.deviceName, deviceType, vendorID
    property DeviceName: RawUtf8 read fDeviceName;
    property DeviceType: integer read fDeviceType;
    property VendorId: integer read fVendorId;
    /// VkPhysicalDeviceLimits.maxStorageBufferRange: Run binds no larger buffer
    property MaxStorageRange: cardinal read fMaxStorageRange;
    /// VkPhysicalDeviceLimits.minStorageBufferOffsetAlignment: the offsets of
    // BatchDispatchAt are multiples of it (at least 1)
    property MinStorageAlignment: TVkDeviceSize read fMinStorageAlign;
    /// VkPhysicalDeviceLimits.maxComputeWorkGroupInvocations (at least 128)
    property MaxInvocations: cardinal read fMaxInvocations;
    /// VkPhysicalDeviceLimits.maxComputeWorkGroupSize[0] (at least 128)
    property MaxGroupSizeX: cardinal read fMaxGroupSizeX;
    /// VkPhysicalDeviceLimits.maxComputeSharedMemorySize (at least 16384)
    property MaxSharedMemory: cardinal read fMaxSharedMemory;
    /// the Vulkan version in use: VK_API_VERSION_1_1 when the loader and the
    // device have it (SPIR-V 1.3 shaders, subgroup operations), else 1.0
    property ApiVersion: cardinal read fApiVersion;
    /// VkPhysicalDeviceSubgroupProperties - 0 with Vulkan 1.0
    property SubgroupSize: cardinal read fSubgroupSize;
    property SubgroupStages: cardinal read fSubgroupStages;
    property SubgroupOperations: cardinal read fSubgroupOperations;
    /// true on a portability implementation such as MoltenVK: the device lists
    // VK_KHR_portability_subset, which is then enabled
    property Portability: boolean read fPortability;
    /// true: every batch writes a GPU timestamp after each operation and sums
    // the time per pipeline name (needs timestamp support on the queue; MoltenVK
    // on Apple GPUs samples only between Metal encoders: one value for a whole
    // batch, see HasTimestamps)
    property Profile: boolean read fProfile write fProfile;
    /// the summed GPU time per name since ProfileReset, longest first
    function ProfileText: RawUtf8;
    /// forget the summed times
    procedure ProfileReset;
    /// true when the compute queue writes timestamps (Profile can measure) -
    // false once a portability device (MoltenVK) stamped two operations alike
    function HasTimestamps: boolean;
  end;

const
  /// the loader of this platform, as the Vulkan SDK names it
  VULKAN_LIBRARY =
    {$ifdef OSWINDOWS} 'vulkan-1.dll' {$else}
    {$ifdef OSDARWIN} 'libvulkan.1.dylib' {$else}
    'libvulkan.so.1' {$endif OSDARWIN} {$endif OSWINDOWS};
  {$ifdef OSDARWIN}
  /// the loader of Homebrew on Apple silicon: dlopen() of a bare name does
  // not search /opt/homebrew/lib (it does search /usr/local/lib, where the
  // Vulkan SDK and Homebrew on Intel put it)
  VULKAN_LIBRARY_HOMEBREW = '/opt/homebrew/lib/' + VULKAN_LIBRARY;
  {$endif OSDARWIN}

{$I mormot.ai.infer.vulkan.spv.inc}


implementation

const
  /// the command buffers of a batch: BatchFlush submits up to VK_BATCH_CMDS - 1
  VK_BATCH_CMDS = 8;
  /// descriptor sets of one batch: a forward pass of a 64-layer model needs
  // about a thousand (BatchMaxSets)
  VK_BATCH_SETS = 4096;

var
  // TInferVulkan.Available: 0 = not tried yet, 1 = yes, 2 = no
  VulkanAvailable: integer;

function VkHasExtension(const aList: TVkExtensionPropertiesDynArray;
  aName: PAnsiChar): boolean;
var
  i: PtrInt;
begin
  result := true;
  for i := 0 to length(aList) - 1 do
    if StrComp(@aList[i].extensionName, aName) = 0 then
      exit;
  result := false;
end;

{$ifdef CPUX86}
{$ifndef FPC}
  {$define DRIVERMXCSR} // Delphi's Win32 SetExceptionMask covers only the x87
{$endif FPC}
{$endif CPUX86}

type
  /// the floating-point state to restore after a call into the driver
  TDriverFpu = record
    Mask: TFPUExceptionMask;
    {$ifdef DRIVERMXCSR}
    Mxcsr: cardinal;
    {$endif DRIVERMXCSR}
  end;

{$ifdef DRIVERMXCSR}
function MxcsrGet: cardinal;
asm
        push    eax
        db      $0F, $AE, $1C, $24 // stmxcsr [esp]
        pop     eax
end;

procedure MxcsrSet(aValue: cardinal);
asm
        push    eax
        db      $0F, $AE, $14, $24 // ldmxcsr [esp]
        pop     eax
end;
{$endif DRIVERMXCSR}

/// every floating-point exception masked, as drivers expect: FPC and Delphi
// unmask some, and a driver's own threads (lavapipe's LLVM workers) inherit
// the mask of the thread that creates them - a trap there hangs the process
// - returns the state to restore once the call into the driver is done
function DriverFpuEnter: TDriverFpu;
begin
  result.Mask := GetExceptionMask;
  SetExceptionMask([exInvalidOp, exDenormalized, exZeroDivide, exOverflow,
    exUnderflow, exPrecision]);
  {$ifdef DRIVERMXCSR}
  result.Mxcsr := MxcsrGet;
  MxcsrSet(result.Mxcsr or $1f80); // the six SSE exception mask bits
  {$endif DRIVERMXCSR}
end;

{$ifdef CPUX86}
/// clear the x87 exception flags: a driver may leave one set under the masked
// state, and unmasking with a flag pending makes the next x87 instruction of
// the caller raise (SSE flags are sticky but never raise afterwards)
procedure X87ClearFlags;
asm
        fnclex
end;
{$endif CPUX86}

procedure DriverFpuLeave(const aState: TDriverFpu);
begin
  {$ifdef CPUX86}
  X87ClearFlags;
  {$endif CPUX86}
  SetExceptionMask(aState.Mask);
  {$ifdef DRIVERMXCSR}
  MxcsrSet(aState.Mxcsr);
  {$endif DRIVERMXCSR}
end;


{ TInferVulkan }

procedure TInferVulkan.Check(aResult: TVkResult; const aCall: RawUtf8);
begin
  if aResult <> VK_SUCCESS then
    raise EInferVulkan.CreateUtf8('Vulkan: % failed with VkResult %',
      [aCall, aResult]);
end;

procedure TInferVulkan.CheckNew(aResult: TVkResult; var aHandle: TVkHandle;
  const aCall: RawUtf8);
begin
  if aResult = VK_SUCCESS then
    exit;
  aHandle := 0;
  Check(aResult, aCall);
end;

procedure TInferVulkan.CheckNew(aResult: TVkResult; var aPointer: pointer;
  const aCall: RawUtf8);
begin
  if aResult = VK_SUCCESS then
    exit;
  aPointer := nil;
  Check(aResult, aCall);
end;

procedure TInferVulkan.Load(var aProc; aName: PAnsiChar; aFromDevice: boolean);
begin
  if aFromDevice then
    pointer(aProc) := fApi.GetDeviceProcAddr(fDevice, aName)
  else
    pointer(aProc) := fApi.GetInstanceProcAddr(fInstance, aName);
  if pointer(aProc) = nil then
    raise EInferVulkan.CreateUtf8('Vulkan: no entry point %', [aName]);
end;

function TInferVulkan.TryMemoryType(aBits: cardinal; aFlags: TVkFlags): integer;
var
  i: integer;
begin
  // the first match: Vulkan lists the faster types of a kind first
  for i := 0 to integer(fMemory.memoryTypeCount) - 1 do
    if (aBits and (cardinal(1) shl i) <> 0) and
       (fMemory.memoryTypes[i].propertyFlags and aFlags = aFlags) then
    begin
      result := i;
      exit;
    end;
  result := -1;
end;

function TInferVulkan.MemoryType(aBits: cardinal; aFlags: TVkFlags): integer;
begin
  result := TryMemoryType(aBits, aFlags);
  if result < 0 then
    raise EInferVulkan.CreateUtf8('Vulkan: no memory type % in %', [aFlags, aBits]);
end;

constructor TInferVulkan.Create;
var
  fpu: TDriverFpu;
begin
  inherited Create;
  fBatchMax := VK_BATCH_SETS;
  fpu := DriverFpuEnter;
  try
    Open;
  finally
    DriverFpuLeave(fpu);
  end;
end;

procedure TInferVulkan.Open;
const
  // the deviceType ranking: discrete, integrated, virtual, CPU, other
  TYPE_RANK: array[0..4] of integer = (0, 3, 4, 2, 1);
var
  app: TVkApplicationInfo;
  info: TVkInstanceCreateInfo;
  count, i, j, families: cardinal;
  phys: array of TVkDispatch;
  props: array[0..1023] of byte; // VkPhysicalDeviceProperties: 824 bytes
  props2: TVkPhysicalDeviceProperties2;
  sub: TVkPhysicalDeviceSubgroupProperties;
  version: cardinal;
  fam: array of TVkQueueFamilyProperties;
  best, bestRank, rank, wanted, family: integer;
  priority: single;
  qinfo: TVkDeviceQueueCreateInfo;
  dinfo: TVkDeviceCreateInfo;
  pinfo: TVkCommandPoolCreateInfo;
  cinfo: TVkCommandBufferAllocateInfo;
  finfo: TVkFenceCreateInfo;
  exts: TVkExtensionPropertiesDynArray;
  names: array[0..2] of PAnsiChar;
  setting: TVkLayerSettingEXT;
  settings: TVkLayerSettingsCreateInfoEXT;
  off: cardinal;
  res: TVkResult;
begin
  fLib := LibraryOpen(VULKAN_LIBRARY);
  {$ifdef OSDARWIN}
  if fLib = TLibHandle(0) then
    fLib := LibraryOpen(VULKAN_LIBRARY_HOMEBREW);
  {$endif OSDARWIN}
  if fLib = TLibHandle(0) then
    raise EInferVulkan.CreateUtf8('Vulkan: no % loader', [VULKAN_LIBRARY]);
  PPointer(@@fApi.GetInstanceProcAddr)^ := LibraryResolve(fLib, 'vkGetInstanceProcAddr');
  if not Assigned(fApi.GetInstanceProcAddr) then
    raise EInferVulkan.Create('Vulkan: no vkGetInstanceProcAddr in the loader');
  Load(fApi.CreateInstance, 'vkCreateInstance', false); // fInstance = nil: global
  // Vulkan 1.1 when the loader has it (a 1.0 loader refuses a higher
  // apiVersion): subgroup properties and SPIR-V 1.3 shaders
  PPointer(@@fApi.EnumerateInstanceVersion)^ :=
    fApi.GetInstanceProcAddr(nil, 'vkEnumerateInstanceVersion');
  fApiVersion := VK_API_VERSION_1_0;
  version := 0;
  if Assigned(fApi.EnumerateInstanceVersion) and
     (fApi.EnumerateInstanceVersion(version) = VK_SUCCESS) and
     (version and VK_API_VERSION_MASK >= VK_API_VERSION_1_1) then
    fApiVersion := VK_API_VERSION_1_1;
  FillCharFast(app, SizeOf(app), 0);
  app.sType := VK_STRUCTURE_TYPE_APPLICATION_INFO;
  app.pApplicationName := 'mormot.ai.infer';
  app.pEngineName := 'mormot.ai.infer';
  app.apiVersion := fApiVersion;
  FillCharFast(info, SizeOf(info), 0);
  info.sType := VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
  info.pApplicationInfo := @app;
  // a portability implementation (MoltenVK) is listed only on request
  PPointer(@@fApi.EnumerateInstanceExtensionProperties)^ :=
    fApi.GetInstanceProcAddr(nil, 'vkEnumerateInstanceExtensionProperties');
  if Assigned(fApi.EnumerateInstanceExtensionProperties) then
  begin
    repeat // again on VK_INCOMPLETE: the list grew between both calls
      count := 0;
      Check(fApi.EnumerateInstanceExtensionProperties(nil, count, nil),
        'vkEnumerateInstanceExtensionProperties');
      SetLength(exts, count);
      res := fApi.EnumerateInstanceExtensionProperties(nil, count, pointer(exts));
      if res <> VK_INCOMPLETE then
        Check(res, 'vkEnumerateInstanceExtensionProperties');
    until res = VK_SUCCESS;
    SetLength(exts, count); // count = the entries written
  end;
  if VkHasExtension(exts, VK_KHR_PORTABILITY_ENUMERATION) then
  begin
    names[0] := VK_KHR_PORTABILITY_ENUMERATION;
    info.enabledExtensionCount := 1;
    if (fApiVersion < VK_API_VERSION_1_1) and
       VkHasExtension(exts, VK_KHR_GET_PHYSICAL_DEVICE_PROPERTIES_2) then
    begin
      names[info.enabledExtensionCount] := VK_KHR_GET_PHYSICAL_DEVICE_PROPERTIES_2;
      inc(info.enabledExtensionCount);
    end;
    // MoltenVK without Metal argument buffers: cheap barriers (the compute
    // shaders bind at most eight buffers) - unless the environment sets it,
    // which a layer setting would override
    if VkHasExtension(exts, VK_EXT_LAYER_SETTINGS) and
       (GetEnvironmentVariable(MVK_CONFIG_USE_METAL_ARGUMENT_BUFFERS) = '') then
    begin
      names[info.enabledExtensionCount] := VK_EXT_LAYER_SETTINGS;
      inc(info.enabledExtensionCount);
      off := 0;
      FillCharFast(setting, SizeOf(setting), 0);
      setting.pLayerName := MVK_LAYER_NAME;
      setting.pSettingName := MVK_CONFIG_USE_METAL_ARGUMENT_BUFFERS;
      setting.settingType := VK_LAYER_SETTING_TYPE_BOOL32_EXT;
      setting.valueCount := 1;
      setting.pValues := @off;
      FillCharFast(settings, SizeOf(settings), 0);
      settings.sType := VK_STRUCTURE_TYPE_LAYER_SETTINGS_CREATE_INFO_EXT;
      settings.settingCount := 1;
      settings.pSettings := @setting;
      info.pNext := @settings;
    end;
    info.ppEnabledExtensionNames := @names;
    info.flags := VK_INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR;
  end;
  CheckNew(fApi.CreateInstance(@info, nil, fInstance), fInstance,
    'vkCreateInstance');
  Load(fApi.DestroyInstance, 'vkDestroyInstance', false);
  Load(fApi.EnumeratePhysicalDevices, 'vkEnumeratePhysicalDevices', false);
  Load(fApi.GetPhysicalDeviceProperties, 'vkGetPhysicalDeviceProperties', false);
  Load(fApi.GetPhysicalDeviceQueueFamilyProperties,
    'vkGetPhysicalDeviceQueueFamilyProperties', false);
  Load(fApi.GetPhysicalDeviceMemoryProperties,
    'vkGetPhysicalDeviceMemoryProperties', false);
  Load(fApi.CreateDevice, 'vkCreateDevice', false);
  Load(fApi.GetDeviceProcAddr, 'vkGetDeviceProcAddr', false);
  Load(fApi.EnumerateDeviceExtensionProperties,
    'vkEnumerateDeviceExtensionProperties', false);
  // the physical device: the best ranked one with a compute queue
  count := 0;
  Check(fApi.EnumeratePhysicalDevices(fInstance, count, nil),
    'vkEnumeratePhysicalDevices');
  if count = 0 then
    raise EInferVulkan.Create('Vulkan: no physical device');
  SetLength(phys, count);
  Check(fApi.EnumeratePhysicalDevices(fInstance, count, pointer(phys)),
    'vkEnumeratePhysicalDevices');
  wanted := Utf8ToInteger(StringToUtf8(GetEnvironmentVariable('LAI_VULKAN_DEVICE')),
    -1); // -1: rank them
  best := -1;
  bestRank := -1;
  family := -1;
  for i := 0 to count - 1 do
  begin
    families := 0;
    fApi.GetPhysicalDeviceQueueFamilyProperties(phys[i], families, nil);
    SetLength(fam, families);
    fApi.GetPhysicalDeviceQueueFamilyProperties(phys[i], families, pointer(fam));
    for j := 0 to families - 1 do
      if (fam[j].queueFlags and VK_QUEUE_COMPUTE_BIT <> 0) and
         (fam[j].queueCount > 0) then
      begin
        fApi.GetPhysicalDeviceProperties(phys[i], @props);
        rank := PInteger(@props[16])^; // deviceType
        if (rank >= 0) and (rank <= high(TYPE_RANK)) then
          rank := TYPE_RANK[rank]
        else
          rank := 0;
        if wanted >= 0 then
          if integer(i) = wanted then
            rank := 100
          else
            rank := -1;
        if rank > bestRank then
        begin
          best := i;
          bestRank := rank;
          family := j;
        end;
        break;
      end;
  end;
  if best < 0 then
    raise EInferVulkan.CreateUtf8('Vulkan: no device with a compute queue ' +
      '(LAI_VULKAN_DEVICE=%)', [GetEnvironmentVariable('LAI_VULKAN_DEVICE')]);
  fPhysical := phys[best];
  fFamily := family;
  families := 0;
  fApi.GetPhysicalDeviceQueueFamilyProperties(fPhysical, families, nil);
  SetLength(fam, families);
  fApi.GetPhysicalDeviceQueueFamilyProperties(fPhysical, families, pointer(fam));
  fTimestampBits := fam[family].timestampValidBits;
  fApi.GetPhysicalDeviceProperties(fPhysical, @props);
  fVendorId := PInteger(@props[8])^;
  fDeviceType := PInteger(@props[16])^;
  fDeviceName := PAnsiChar(@props[20]); // deviceName[256], zero-terminated
  // VkPhysicalDeviceLimits starts at byte 296 (offsets from vulkan_core.h, the
  // same for 32 and 64 bits up to the first size_t member)
  fMaxStorageRange := PCardinal(@props[296 + 28])^;
  fMaxInvocations := PCardinal(@props[296 + 232])^;
  fMaxGroupSizeX := PCardinal(@props[296 + 236])^;
  fMaxSharedMemory := PCardinal(@props[296 + 216])^;
  // behind minMemoryMapAlignment (a size_t) too, a VkDeviceSize
  fMinStorageAlign := PInt64(@props[296 + {$ifdef CPU64} 328 {$else} 320 {$endif}])^;
  if fMinStorageAlign < 1 then
    fMinStorageAlign := 1;
  // nanoseconds per tick; behind minMemoryMapAlignment, a size_t: the offset
  // differs between 32 and 64 bits (vulkan_core.h)
  fTimestampPeriod := PSingle(@props[296 + {$ifdef CPU64} 424 {$else} 416 {$endif}])^;
  // the device's version caps what the instance may use on it
  if PCardinal(@props[0])^ and VK_API_VERSION_MASK < VK_API_VERSION_1_1 then
    fApiVersion := VK_API_VERSION_1_0;
  if fApiVersion >= VK_API_VERSION_1_1 then
  begin
    PPointer(@@fApi.GetPhysicalDeviceProperties2)^ :=
      fApi.GetInstanceProcAddr(fInstance, 'vkGetPhysicalDeviceProperties2');
    if Assigned(fApi.GetPhysicalDeviceProperties2) then
    begin
      FillCharFast(sub, SizeOf(sub), 0);
      sub.sType := VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_PROPERTIES;
      FillCharFast(props2, SizeOf(props2), 0);
      props2.sType := VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2;
      props2.pNext := @sub;
      fApi.GetPhysicalDeviceProperties2(fPhysical, @props2);
      fSubgroupSize := sub.subgroupSize;
      fSubgroupStages := sub.supportedStages;
      fSubgroupOperations := sub.supportedOperations;
    end
    else
      fApiVersion := VK_API_VERSION_1_0;
  end;
  fApi.GetPhysicalDeviceMemoryProperties(fPhysical, @fMemory);
  // the device with one compute queue
  priority := 1;
  FillCharFast(qinfo, SizeOf(qinfo), 0);
  qinfo.sType := VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
  qinfo.queueFamilyIndex := fFamily;
  qinfo.queueCount := 1;
  qinfo.pQueuePriorities := @priority;
  FillCharFast(dinfo, SizeOf(dinfo), 0);
  dinfo.sType := VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO;
  dinfo.queueCreateInfoCount := 1;
  dinfo.pQueueCreateInfos := @qinfo;
  // a portability implementation must have VK_KHR_portability_subset enabled
  repeat
    count := 0;
    Check(fApi.EnumerateDeviceExtensionProperties(fPhysical, nil, count, nil),
      'vkEnumerateDeviceExtensionProperties');
    SetLength(exts, count);
    res := fApi.EnumerateDeviceExtensionProperties(fPhysical, nil, count,
      pointer(exts));
    if res <> VK_INCOMPLETE then
      Check(res, 'vkEnumerateDeviceExtensionProperties');
  until res = VK_SUCCESS;
  SetLength(exts, count);
  fPortability := VkHasExtension(exts, VK_KHR_PORTABILITY_SUBSET);
  if fPortability then
  begin
    names[0] := VK_KHR_PORTABILITY_SUBSET;
    dinfo.enabledExtensionCount := 1;
    dinfo.ppEnabledExtensionNames := @names;
  end;
  CheckNew(fApi.CreateDevice(fPhysical, @dinfo, nil, fDevice), fDevice,
    'vkCreateDevice');
  Load(fApi.DestroyDevice, 'vkDestroyDevice', true);
  Load(fApi.GetDeviceQueue, 'vkGetDeviceQueue', true);
  Load(fApi.CreateBuffer, 'vkCreateBuffer', true);
  Load(fApi.DestroyBuffer, 'vkDestroyBuffer', true);
  Load(fApi.GetBufferMemoryRequirements, 'vkGetBufferMemoryRequirements', true);
  Load(fApi.AllocateMemory, 'vkAllocateMemory', true);
  Load(fApi.FreeMemory, 'vkFreeMemory', true);
  Load(fApi.BindBufferMemory, 'vkBindBufferMemory', true);
  Load(fApi.MapMemory, 'vkMapMemory', true);
  Load(fApi.UnmapMemory, 'vkUnmapMemory', true);
  Load(fApi.CreateShaderModule, 'vkCreateShaderModule', true);
  Load(fApi.DestroyShaderModule, 'vkDestroyShaderModule', true);
  Load(fApi.CreateDescriptorSetLayout, 'vkCreateDescriptorSetLayout', true);
  Load(fApi.DestroyDescriptorSetLayout, 'vkDestroyDescriptorSetLayout', true);
  Load(fApi.CreatePipelineLayout, 'vkCreatePipelineLayout', true);
  Load(fApi.DestroyPipelineLayout, 'vkDestroyPipelineLayout', true);
  Load(fApi.CreateComputePipelines, 'vkCreateComputePipelines', true);
  Load(fApi.DestroyPipeline, 'vkDestroyPipeline', true);
  Load(fApi.CreateDescriptorPool, 'vkCreateDescriptorPool', true);
  Load(fApi.DestroyDescriptorPool, 'vkDestroyDescriptorPool', true);
  Load(fApi.ResetDescriptorPool, 'vkResetDescriptorPool', true);
  Load(fApi.AllocateDescriptorSets, 'vkAllocateDescriptorSets', true);
  Load(fApi.UpdateDescriptorSets, 'vkUpdateDescriptorSets', true);
  Load(fApi.CreateCommandPool, 'vkCreateCommandPool', true);
  Load(fApi.DestroyCommandPool, 'vkDestroyCommandPool', true);
  Load(fApi.AllocateCommandBuffers, 'vkAllocateCommandBuffers', true);
  Load(fApi.BeginCommandBuffer, 'vkBeginCommandBuffer', true);
  Load(fApi.EndCommandBuffer, 'vkEndCommandBuffer', true);
  Load(fApi.ResetCommandBuffer, 'vkResetCommandBuffer', true);
  Load(fApi.CmdBindPipeline, 'vkCmdBindPipeline', true);
  Load(fApi.CmdBindDescriptorSets, 'vkCmdBindDescriptorSets', true);
  Load(fApi.CmdPushConstants, 'vkCmdPushConstants', true);
  Load(fApi.CmdDispatch, 'vkCmdDispatch', true);
  Load(fApi.CmdCopyBuffer, 'vkCmdCopyBuffer', true);
  Load(fApi.CreateQueryPool, 'vkCreateQueryPool', true);
  Load(fApi.DestroyQueryPool, 'vkDestroyQueryPool', true);
  Load(fApi.GetQueryPoolResults, 'vkGetQueryPoolResults', true);
  Load(fApi.CmdResetQueryPool, 'vkCmdResetQueryPool', true);
  Load(fApi.CmdWriteTimestamp, 'vkCmdWriteTimestamp', true);
  Load(fApi.CmdPipelineBarrier, 'vkCmdPipelineBarrier', true);
  Load(fApi.QueueSubmit, 'vkQueueSubmit', true);
  Load(fApi.CreateFence, 'vkCreateFence', true);
  Load(fApi.DestroyFence, 'vkDestroyFence', true);
  Load(fApi.WaitForFences, 'vkWaitForFences', true);
  Load(fApi.ResetFences, 'vkResetFences', true);
  Load(fApi.DeviceWaitIdle, 'vkDeviceWaitIdle', true);
  fApi.GetDeviceQueue(fDevice, fFamily, 0, fQueue);
  // one resettable command buffer and one fence for Run
  FillCharFast(pinfo, SizeOf(pinfo), 0);
  pinfo.sType := VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
  pinfo.flags := VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
  pinfo.queueFamilyIndex := fFamily;
  CheckNew(fApi.CreateCommandPool(fDevice, @pinfo, nil, fCmdPool), fCmdPool,
    'vkCreateCommandPool');
  FillCharFast(cinfo, SizeOf(cinfo), 0);
  cinfo.sType := VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
  cinfo.commandPool := fCmdPool;
  cinfo.level := VK_COMMAND_BUFFER_LEVEL_PRIMARY;
  cinfo.commandBufferCount := VK_BATCH_CMDS;
  SetLength(fCmds, VK_BATCH_CMDS);
  if fApi.AllocateCommandBuffers(fDevice, @cinfo, pointer(fCmds)) <> VK_SUCCESS then
  begin
    fCmds := nil; // undefined after a failure: nothing to free one by one
    raise EInferVulkan.Create('Vulkan: vkAllocateCommandBuffers failed');
  end;
  fCmd := fCmds[0];
  FillCharFast(finfo, SizeOf(finfo), 0);
  finfo.sType := VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
  CheckNew(fApi.CreateFence(fDevice, @finfo, nil, fFence), fFence, 'vkCreateFence');
end;

destructor TInferVulkan.Destroy;
var
  fpu: TDriverFpu;
begin
  fpu := DriverFpuEnter;
  try
    Close;
  finally
    DriverFpuLeave(fpu);
  end;
  inherited Destroy;
end;

procedure TInferVulkan.Close;
begin
  // after a Run that did not finish, the device may still work on objects the
  // buffers and pipelines did not release: give the whole context up, leaking
  // device, instance and loader - never destroy what may still be in use
  if fBroken then
    exit;
  FreeAndNil(fStaging);
  // Open may have failed halfway: only what was created, through the entry
  // points that were loaded
  if (fDevice <> nil) and Assigned(fApi.DestroyDevice) then
  begin
    if Assigned(fApi.DeviceWaitIdle) then
      fApi.DeviceWaitIdle(fDevice);
    if (fBatchPool <> 0) and Assigned(fApi.DestroyDescriptorPool) then
      fApi.DestroyDescriptorPool(fDevice, fBatchPool, nil);
    if (fQueryPool <> 0) and Assigned(fApi.DestroyQueryPool) then
      fApi.DestroyQueryPool(fDevice, fQueryPool, nil);
    if (fFence <> 0) and Assigned(fApi.DestroyFence) then
      fApi.DestroyFence(fDevice, fFence, nil);
    if (fCmdPool <> 0) and Assigned(fApi.DestroyCommandPool) then
      fApi.DestroyCommandPool(fDevice, fCmdPool, nil); // frees fCmd too
    fApi.DestroyDevice(fDevice, nil);
  end;
  if (fInstance <> nil) and Assigned(fApi.DestroyInstance) then
    fApi.DestroyInstance(fInstance, nil);
  if fLib <> TLibHandle(0) then
    LibraryClose(fLib);
end;

class function TInferVulkan.Available: boolean;
var
  vk: TInferVulkan;
begin
  if VulkanAvailable = 0 then
    try
      vk := TInferVulkan.Create;
      vk.Free;
      VulkanAvailable := 1;
    except
      VulkanAvailable := 2;
    end;
  result := VulkanAvailable = 1;
end;

procedure TInferVulkan.Run(aPipeline: TInferVkPipeline;
  const aBuffers: array of TInferVkBuffer; aPush: pointer; aX, aY, aZ: cardinal);
var
  fpu: TDriverFpu;
begin
  fpu := DriverFpuEnter;
  try
    DoRun(aPipeline, aBuffers, aPush, aX, aY, aZ);
  finally
    DriverFpuLeave(fpu);
  end;
end;

procedure TInferVulkan.DoRun(aPipeline: TInferVkPipeline;
  const aBuffers: array of TInferVkBuffer; aPush: pointer; aX, aY, aZ: cardinal);
begin
  if fBroken then
    raise EInferVulkan.Create('Vulkan.Run: an earlier Run did not finish');
  if fBatching then
    raise EInferVulkan.Create('Vulkan.Run: a batch is being recorded');
  Bind(aPipeline, aPipeline.fSet, aBuffers, nil, nil);
  CmdBegin;
  fApi.CmdBindPipeline(fCmd, VK_PIPELINE_BIND_POINT_COMPUTE, aPipeline.fPipeline);
  fApi.CmdBindDescriptorSets(fCmd, VK_PIPELINE_BIND_POINT_COMPUTE,
    aPipeline.fLayout, 0, 1, @aPipeline.fSet, 0, nil);
  if aPipeline.PushSize > 0 then
    fApi.CmdPushConstants(fCmd, aPipeline.fLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
      aPipeline.PushSize, aPush);
  fApi.CmdDispatch(fCmd, aX, aY, aZ);
  CmdSubmit;
end;

procedure TInferVulkan.Bind(aPipeline: TInferVkPipeline; aSet: TVkHandle;
  const aBuffers: array of TInferVkBuffer; aOffsets, aRanges: PInt64Array);
var
  infos: array[0..VK_MAX_BINDINGS - 1] of TVkDescriptorBufferInfo;
  writes: array[0..VK_MAX_BINDINGS - 1] of TVkWriteDescriptorSet;
  i: PtrInt;
  offset, range: TVkDeviceSize;
begin
  if length(aBuffers) <> aPipeline.Buffers then
    raise EInferVulkan.CreateUtf8('Vulkan.Run: % buffers for a pipeline of %',
      [length(aBuffers), aPipeline.Buffers]);
  // the buffers into the pipeline's one descriptor set (no Run is pending:
  // the previous one waited for its fence)
  FillCharFast(writes, SizeOf(writes), 0);
  for i := 0 to high(aBuffers) do
  begin
    range := 0;
    offset := 0;
    if aRanges <> nil then
    begin
      range := aRanges^[i];
      offset := aOffsets^[i];
    end;
    if range = 0 then
    begin
      if aBuffers[i].Size > fMaxStorageRange then
        raise EInferVulkan.CreateUtf8('Vulkan.Run: buffer % of % bytes, the device ' +
          'binds at most %', [i, aBuffers[i].Size, fMaxStorageRange]);
      offset := 0;
      range := VK_WHOLE_SIZE;
    end
    else if (offset < 0) or (offset > aBuffers[i].Size) or (range < 0) or
            (range > aBuffers[i].Size - offset) or (range > fMaxStorageRange) or
            (offset mod fMinStorageAlign <> 0) then
      raise EInferVulkan.CreateUtf8('Vulkan.Run: % bytes at % of buffer % (% bytes; ' +
        'the device binds at most % from multiples of %)', [range, offset, i,
        aBuffers[i].Size, fMaxStorageRange, fMinStorageAlign]);
    infos[i].buffer := aBuffers[i].Handle;
    infos[i].offset := offset;
    infos[i].range := range;
    writes[i].sType := VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
    writes[i].dstSet := aSet;
    writes[i].dstBinding := i;
    writes[i].descriptorCount := 1;
    writes[i].descriptorType := VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
    writes[i].pBufferInfo := @infos[i];
  end;
  fApi.UpdateDescriptorSets(fDevice, length(aBuffers), @writes, 0, nil);
end;

procedure TInferVulkan.CmdBegin;
var
  begin_: TVkCommandBufferBeginInfo;
  barrier: TVkMemoryBarrier;
begin
  Check(fApi.ResetCommandBuffer(fCmd, 0), 'vkResetCommandBuffer');
  FillCharFast(begin_, SizeOf(begin_), 0);
  begin_.sType := VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
  begin_.flags := VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
  Check(fApi.BeginCommandBuffer(fCmd, @begin_), 'vkBeginCommandBuffer');
  fRecording := true;
  // a fence orders execution, not memory: the device writes of the previous
  // submission (a copy, a shader) become visible to this one here
  FillCharFast(barrier, SizeOf(barrier), 0);
  barrier.sType := VK_STRUCTURE_TYPE_MEMORY_BARRIER;
  barrier.srcAccessMask := VK_ACCESS_MEMORY_WRITE_BIT;
  barrier.dstAccessMask := VK_ACCESS_MEMORY_READ_BIT or VK_ACCESS_MEMORY_WRITE_BIT;
  fApi.CmdPipelineBarrier(fCmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
    VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, @barrier, 0, nil, 0, nil);
end;

procedure TInferVulkan.CmdSubmit;
var
  barrier: TVkMemoryBarrier;
  submit: TVkSubmitInfo;
  res: TVkResult;
begin
  // the device writes become visible to the host (memory is coherent: the
  // fence wait then makes them available)
  FillCharFast(barrier, SizeOf(barrier), 0);
  barrier.sType := VK_STRUCTURE_TYPE_MEMORY_BARRIER;
  barrier.srcAccessMask := VK_ACCESS_MEMORY_WRITE_BIT;
  barrier.dstAccessMask := VK_ACCESS_HOST_READ_BIT;
  fApi.CmdPipelineBarrier(fCmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
    VK_PIPELINE_STAGE_HOST_BIT, 0, 1, @barrier, 0, nil, 0, nil);
  fRecording := false; // ended, or invalid after a failure: no second end
  Check(fApi.EndCommandBuffer(fCmd), 'vkEndCommandBuffer');
  FillCharFast(submit, SizeOf(submit), 0);
  submit.sType := VK_STRUCTURE_TYPE_SUBMIT_INFO;
  submit.commandBufferCount := 1;
  submit.pCommandBuffers := @fCmd;
  Check(fApi.QueueSubmit(fQueue, 1, @submit, fFence), 'vkQueueSubmit');
  // from here on, any failure leaves work pending or the fence signaled: the
  // context is given up (no Run any more, nothing released - see Close)
  res := fApi.WaitForFences(fDevice, 1, @fFence, 1, Int64(60) * 1000000000);
  if res <> VK_SUCCESS then
  begin
    fBroken := true;
    Check(res, 'vkWaitForFences');
  end;
  res := fApi.ResetFences(fDevice, 1, @fFence);
  if res <> VK_SUCCESS then
  begin
    fBroken := true;
    Check(res, 'vkResetFences');
  end;
end;

procedure TInferVulkan.Upload(aBuffer: TInferVkBuffer; aOffset: TVkDeviceSize;
  aSource: pointer; aBytes: TVkDeviceSize);
var
  fpu: TDriverFpu;
begin
  fpu := DriverFpuEnter;
  try
    DoCopy(true, aBuffer, aOffset, aSource, aBytes);
  finally
    DriverFpuLeave(fpu);
  end;
end;

procedure TInferVulkan.Download(aBuffer: TInferVkBuffer; aOffset: TVkDeviceSize;
  aDest: pointer; aBytes: TVkDeviceSize);
var
  fpu: TDriverFpu;
begin
  fpu := DriverFpuEnter;
  try
    DoCopy(false, aBuffer, aOffset, aDest, aBytes);
  finally
    DriverFpuLeave(fpu);
  end;
end;

const
  /// the staging buffer: grown up to this size, larger copies go in chunks
  VK_STAGING_MAX = 16 shl 20;

procedure TInferVulkan.DoCopy(aUp: boolean; aBuffer: TInferVkBuffer;
  aOffset: TVkDeviceSize; aHost: PByte; aBytes: TVkDeviceSize);
var
  region: TVkBufferCopy;
  n: TVkDeviceSize;
begin
  if fBroken then
    raise EInferVulkan.Create('Vulkan: an earlier Run did not finish');
  if fBatching then
    raise EInferVulkan.Create('Vulkan: a batch is being recorded');
  if (aOffset < 0) or (aBytes < 0) or (aOffset + aBytes > aBuffer.Size) then
    raise EInferVulkan.CreateUtf8('Vulkan: copy of % bytes at % into a buffer of %',
      [aBytes, aOffset, aBuffer.Size]);
  if aBytes = 0 then
    exit;
  if aBuffer.Mapped <> nil then
  begin
    // host-visible coherent: a plain copy (no Run is pending - each waited)
    if aUp then
      MoveFast(aHost^, PByteArray(aBuffer.Mapped)^[aOffset], aBytes)
    else
      MoveFast(PByteArray(aBuffer.Mapped)^[aOffset], aHost^, aBytes);
    exit;
  end;
  if (fStaging = nil) or (fStaging.Size < aBytes) then
    if (fStaging = nil) or (fStaging.Size < VK_STAGING_MAX) then
    begin
      FreeAndNil(fStaging);
      n := aBytes;
      if n > VK_STAGING_MAX then
        n := VK_STAGING_MAX;
      fStaging := TInferVkBuffer.CreateReadback(self, n); // both ways
    end;
  while aBytes > 0 do
  begin
    n := aBytes;
    if n > fStaging.Size then
      n := fStaging.Size;
    if aUp then
      MoveFast(aHost^, fStaging.Mapped^, n);
    CmdBegin;
    if aUp then
    begin
      region.srcOffset := 0;
      region.dstOffset := aOffset;
    end
    else
    begin
      region.srcOffset := aOffset;
      region.dstOffset := 0;
    end;
    region.size := n;
    if aUp then
      fApi.CmdCopyBuffer(fCmd, fStaging.Handle, aBuffer.Handle, 1, @region)
    else
      fApi.CmdCopyBuffer(fCmd, aBuffer.Handle, fStaging.Handle, 1, @region);
    CmdSubmit;
    if not aUp then
      MoveFast(fStaging.Mapped^, aHost^, n);
    inc(aHost, n);
    inc(aOffset, n);
    dec(aBytes, n);
  end;
end;

procedure TInferVulkan.Barrier;
var
  barrier: TVkMemoryBarrier;
begin
  // every write so far before every later access: the operations of a batch
  // form one chain
  FillCharFast(barrier, SizeOf(barrier), 0);
  barrier.sType := VK_STRUCTURE_TYPE_MEMORY_BARRIER;
  barrier.srcAccessMask := VK_ACCESS_MEMORY_WRITE_BIT;
  barrier.dstAccessMask := VK_ACCESS_MEMORY_READ_BIT or VK_ACCESS_MEMORY_WRITE_BIT;
  fApi.CmdPipelineBarrier(fCmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
    VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, @barrier, 0, nil, 0, nil);
end;

procedure TInferVulkan.BatchBegin;
var
  fpu: TDriverFpu;
begin
  fpu := DriverFpuEnter;
  try
    DoBatchBegin;
  finally
    DriverFpuLeave(fpu);
  end;
end;

procedure TInferVulkan.DoBatchBegin;
var
  size: TVkDescriptorPoolSize;
  info: TVkDescriptorPoolCreateInfo;
  qinfo: TVkQueryPoolCreateInfo;
begin
  if fBroken then
    raise EInferVulkan.Create('Vulkan: an earlier Run did not finish');
  if fBatching then
    raise EInferVulkan.Create('Vulkan: a batch is being recorded');
  if fBatchPool = 0 then
  begin
    size.descriptorType := VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
    size.descriptorCount := VK_BATCH_SETS * VK_MAX_BINDINGS;
    FillCharFast(info, SizeOf(info), 0);
    info.sType := VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
    info.maxSets := VK_BATCH_SETS;
    info.poolSizeCount := 1;
    info.pPoolSizes := @size;
    CheckNew(fApi.CreateDescriptorPool(fDevice, @info, nil, fBatchPool), fBatchPool,
      'vkCreateDescriptorPool');
  end
  else
    // no batch is pending (each waited): its sets may go
    Check(fApi.ResetDescriptorPool(fDevice, fBatchPool, 0), 'vkResetDescriptorPool');
  fBatchSets := 0;
  fProfiling := fProfile and HasTimestamps;
  if fProfiling and (fQueryPool = 0) then
  begin
    FillCharFast(qinfo, SizeOf(qinfo), 0);
    qinfo.sType := VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
    qinfo.queryType := VK_QUERY_TYPE_TIMESTAMP;
    qinfo.queryCount := VK_BATCH_SETS * 2;
    CheckNew(fApi.CreateQueryPool(fDevice, @qinfo, nil, fQueryPool), fQueryPool,
      'vkCreateQueryPool');
  end;
  QueryPerformanceMicroSeconds(fRecordStart);
  fCmdIndex := 0;
  fCmd := fCmds[0];
  fFlushed := false;
  CmdBegin;
  fBatching := true;
  fQueries := 0;
  if fProfiling then
  begin
    fApi.CmdResetQueryPool(fCmd, fQueryPool, 0, VK_BATCH_SETS * 2);
    Stamp('');
  end;
end;

procedure TInferVulkan.Stamp(const aTag: RawUtf8);
begin
  if not fProfiling or (fQueries >= VK_BATCH_SETS * 2) then
    exit;
  fApi.CmdWriteTimestamp(fCmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, fQueryPool,
    fQueries);
  if fQueries >= length(fQueryTag) then
    SetLength(fQueryTag, VK_BATCH_SETS * 2);
  fQueryTag[fQueries] := aTag;
  inc(fQueries);
end;

procedure TInferVulkan.Collect;
var
  ticks: TInt64DynArray;
  i, j: PtrInt;
  mask: Int64;
  ns: Int64;
begin
  if not fProfiling or (fQueries < 2) then
    exit;
  SetLength(ticks, fQueries);
  Check(fApi.GetQueryPoolResults(fDevice, fQueryPool, 0, fQueries, fQueries * 8,
    pointer(ticks), 8, VK_QUERY_RESULT_64_BIT or VK_QUERY_RESULT_WAIT_BIT),
    'vkGetQueryPoolResults');
  // a portability implementation which writes the same tick twice in a row
  // samples per Metal encoder, not per operation (MoltenVK on Apple GPUs, also
  // across the command buffers of BatchFlush): its times are meaningless, so
  // profiling stops - a native device never decides so (a tick may be long)
  if fPortability then
    for i := 1 to fQueries - 1 do
      if ticks[i] = ticks[i - 1] then
      begin
        fTimestampsFlat := true;
        exit;
      end;
  if fTimestampBits >= 64 then
    mask := -1
  else
    mask := (Int64(1) shl fTimestampBits) - 1;
  for i := 1 to fQueries - 1 do
  begin
    ns := Round(((ticks[i] - ticks[i - 1]) and mask) * fTimestampPeriod);
    j := 0;
    while (j < length(fProfName)) and (fProfName[j] <> fQueryTag[i]) do
      inc(j);
    if j = length(fProfName) then
    begin
      SetLength(fProfName, j + 1);
      SetLength(fProfNs, j + 1);
      SetLength(fProfCount, j + 1);
      fProfName[j] := fQueryTag[i];
    end;
    inc(fProfNs[j], ns);
    inc(fProfCount[j]);
  end;
end;

function TInferVulkan.HasTimestamps: boolean;
begin
  result := (fTimestampBits > 0) and (fTimestampPeriod > 0) and
    not fTimestampsFlat;
end;

procedure TInferVulkan.ProfileReset;
begin
  fRecordUs := 0;
  fWaitUs := 0;
  fBatches := 0;
  fProfName := nil;
  fProfNs := nil;
  fProfCount := nil;
end;

function TInferVulkan.ProfileText: RawUtf8;
var
  i, j, best: PtrInt;
  total: Int64;
  done: array of boolean;
  list: RawUtf8;
begin
  result := '';
  list := '';
  total := 0;
  for i := 0 to high(fProfNs) do
    inc(total, fProfNs[i]);
  if total = 0 then
    exit;
  SetLength(done, length(fProfNs));
  for i := 0 to high(fProfNs) do
  begin
    best := -1;
    for j := 0 to high(fProfNs) do
      if not done[j] and ((best < 0) or (fProfNs[j] > fProfNs[best])) then
        best := j;
    done[best] := true;
    if list <> '' then
      list := list + ', ';
    list := list + FormatUtf8('% % ms (% pct, % x)', [fProfName[best],
      fProfNs[best] div 1000 / 1000, fProfNs[best] * 100 div total, fProfCount[best]]);
  end;
  result := FormatUtf8('% batches, host recording % ms, submit and wait % ms; ' +
    'GPU % ms: %', [fBatches, fRecordUs / 1000, fWaitUs / 1000,
    total div 1000 / 1000, list]);
end;

procedure TInferVulkan.BatchDispatch(aPipeline: TInferVkPipeline;
  const aBuffers: array of TInferVkBuffer; aPush: pointer; aX, aY, aZ: cardinal;
  aBarrier: boolean);
var
  fpu: TDriverFpu;
begin
  fpu := DriverFpuEnter;
  try
    DoBatchDispatch(aPipeline, aBuffers, nil, nil, aPush, aX, aY, aZ, aBarrier);
  finally
    DriverFpuLeave(fpu);
  end;
end;

procedure TInferVulkan.BatchDispatchAt(aPipeline: TInferVkPipeline;
  const aBuffers: array of TInferVkBuffer; const aOffsets, aRanges: array of Int64;
  aPush: pointer; aX, aY, aZ: cardinal; aBarrier: boolean);
var
  fpu: TDriverFpu;
begin
  if (length(aBuffers) = 0) or (length(aOffsets) <> length(aBuffers)) or
     (length(aRanges) <> length(aBuffers)) then
    raise EInferVulkan.CreateUtf8('Vulkan.BatchDispatchAt: % buffers, % offsets, ' +
      '% ranges', [length(aBuffers), length(aOffsets), length(aRanges)]);
  fpu := DriverFpuEnter;
  try
    DoBatchDispatch(aPipeline, aBuffers, @aOffsets[0], @aRanges[0], aPush, aX, aY, aZ,
      aBarrier);
  finally
    DriverFpuLeave(fpu);
  end;
end;

procedure TInferVulkan.DoBatchDispatch(aPipeline: TInferVkPipeline;
  const aBuffers: array of TInferVkBuffer; aOffsets, aRanges: PInt64Array;
  aPush: pointer; aX, aY, aZ: cardinal; aBarrier: boolean);
var
  ainfo: TVkDescriptorSetAllocateInfo;
  dset: TVkHandle;
begin
  if not fBatching then
    raise EInferVulkan.Create('Vulkan.BatchDispatch: no BatchBegin');
  if fBatchSets >= fBatchMax then
    raise EInferVulkan.CreateUtf8('Vulkan.BatchDispatch: more than % dispatches',
      [fBatchMax]);
  FillCharFast(ainfo, SizeOf(ainfo), 0);
  ainfo.sType := VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
  ainfo.descriptorPool := fBatchPool;
  ainfo.descriptorSetCount := 1;
  ainfo.pSetLayouts := @aPipeline.fSetLayout;
  dset := 0;
  Check(fApi.AllocateDescriptorSets(fDevice, @ainfo, @dset),
    'vkAllocateDescriptorSets');
  inc(fBatchSets);
  Bind(aPipeline, dset, aBuffers, aOffsets, aRanges);
  fApi.CmdBindPipeline(fCmd, VK_PIPELINE_BIND_POINT_COMPUTE, aPipeline.fPipeline);
  fApi.CmdBindDescriptorSets(fCmd, VK_PIPELINE_BIND_POINT_COMPUTE,
    aPipeline.fLayout, 0, 1, @dset, 0, nil);
  if aPipeline.PushSize > 0 then
    fApi.CmdPushConstants(fCmd, aPipeline.fLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
      aPipeline.PushSize, aPush);
  fApi.CmdDispatch(fCmd, aX, aY, aZ);
  if aBarrier then
  begin
    Barrier;
    Stamp(aPipeline.Name);
  end;
end;

procedure TInferVulkan.BatchCopy(aSrc: TInferVkBuffer; aSrcOffset: TVkDeviceSize;
  aDst: TInferVkBuffer; aDstOffset: TVkDeviceSize; aBytes: TVkDeviceSize);
var
  fpu: TDriverFpu;
  region: TVkBufferCopy;
begin
  if not fBatching then
    raise EInferVulkan.Create('Vulkan.BatchCopy: no BatchBegin');
  if (aSrcOffset < 0) or (aDstOffset < 0) or (aBytes <= 0) or
     (aSrcOffset + aBytes > aSrc.Size) or (aDstOffset + aBytes > aDst.Size) then
    raise EInferVulkan.CreateUtf8('Vulkan.BatchCopy: % bytes from % of % to % of %',
      [aBytes, aSrcOffset, aSrc.Size, aDstOffset, aDst.Size]);
  fpu := DriverFpuEnter;
  try
    region.srcOffset := aSrcOffset;
    region.dstOffset := aDstOffset;
    region.size := aBytes;
    fApi.CmdCopyBuffer(fCmd, aSrc.Handle, aDst.Handle, 1, @region);
    Barrier;
    Stamp('copy');
  finally
    DriverFpuLeave(fpu);
  end;
end;

procedure TInferVulkan.BatchCopyRows(aSrc: TInferVkBuffer; aSrcOffset,
  aSrcStride: TVkDeviceSize; aDst: TInferVkBuffer; aDstOffset,
  aDstStride: TVkDeviceSize; aBytes: TVkDeviceSize; aRows: PtrInt);
var
  fpu: TDriverFpu;
  regions: array of TVkBufferCopy;
  i: PtrInt;
begin
  if not fBatching then
    raise EInferVulkan.Create('Vulkan.BatchCopyRows: no BatchBegin');
  if (aSrcOffset < 0) or (aDstOffset < 0) or (aSrcStride < 0) or
     (aDstStride < 0) or (aBytes <= 0) or (aRows < 1) or
     (aSrcOffset + (aRows - 1) * aSrcStride + aBytes > aSrc.Size) or
     (aDstOffset + (aRows - 1) * aDstStride + aBytes > aDst.Size) then
    raise EInferVulkan.CreateUtf8('Vulkan.BatchCopyRows: % rows of % bytes ' +
      'from % (stride %) of % to % (stride %) of %', [aRows, aBytes, aSrcOffset,
      aSrcStride, aSrc.Size, aDstOffset, aDstStride, aDst.Size]);
  SetLength(regions, aRows);
  for i := 0 to aRows - 1 do
  begin
    regions[i].srcOffset := aSrcOffset + i * aSrcStride;
    regions[i].dstOffset := aDstOffset + i * aDstStride;
    regions[i].size := aBytes;
  end;
  fpu := DriverFpuEnter;
  try
    fApi.CmdCopyBuffer(fCmd, aSrc.Handle, aDst.Handle, aRows, pointer(regions));
    Barrier;
    Stamp('copy');
  finally
    DriverFpuLeave(fpu);
  end;
end;

procedure TInferVulkan.BatchSubmit;
var
  fpu: TDriverFpu;
  t1, t2: Int64;
begin
  if not fBatching then
    raise EInferVulkan.Create('Vulkan.BatchSubmit: no BatchBegin');
  fBatching := false;
  fpu := DriverFpuEnter;
  try
    QueryPerformanceMicroSeconds(t1);
    try
      CmdSubmit;
    except
      // flushed command buffers may still run without a fence to wait for
      if fFlushed then
        fBroken := true;
      raise;
    end;
    fFlushed := false;
    QueryPerformanceMicroSeconds(t2);
    inc(fRecordUs, t1 - fRecordStart);
    inc(fWaitUs, t2 - t1);
    inc(fBatches);
    Collect;
  finally
    DriverFpuLeave(fpu);
  end;
end;

procedure TInferVulkan.BatchFlush;
var
  fpu: TDriverFpu;
  submit: TVkSubmitInfo;
begin
  if not fBatching then
    raise EInferVulkan.Create('Vulkan.BatchFlush: no BatchBegin');
  if fCmdIndex >= VK_BATCH_CMDS - 1 then
    exit; // the last command buffer takes the rest of the batch
  fpu := DriverFpuEnter;
  try
    fRecording := false; // ended, or invalid after a failure: no second end
    Check(fApi.EndCommandBuffer(fCmd), 'vkEndCommandBuffer');
    FillCharFast(submit, SizeOf(submit), 0);
    submit.sType := VK_STRUCTURE_TYPE_SUBMIT_INFO;
    submit.commandBufferCount := 1;
    submit.pCommandBuffers := @fCmd;
    // no fence: the one of BatchSubmit covers every earlier submission of
    // the queue too; the barrier CmdBegin records first orders the next
    // command buffer after this one (submission order)
    if fApi.QueueSubmit(fQueue, 1, @submit, 0) <> VK_SUCCESS then
    begin
      fBroken := true; // earlier flushes may run: nothing may be reused
      fBatching := false;
      raise EInferVulkan.Create('Vulkan.BatchFlush: vkQueueSubmit failed');
    end;
    fFlushed := true;
    inc(fCmdIndex);
    fCmd := fCmds[fCmdIndex];
    CmdBegin;
  finally
    DriverFpuLeave(fpu);
  end;
end;

function TInferVulkan.BatchRoom: integer;
begin
  result := fBatchMax - fBatchSets;
end;

procedure TInferVulkan.SetBatchMax(aValue: integer);
begin
  if aValue < 16 then
    aValue := 16
  else if aValue > VK_BATCH_SETS then
    aValue := VK_BATCH_SETS;
  fBatchMax := aValue;
end;

procedure TInferVulkan.BatchAbort;
var
  fpu: TDriverFpu;
begin
  if not fBatching then
    exit;
  fBatching := false;
  fpu := DriverFpuEnter;
  try
    // end the recording, the next CmdBegin resets it
    if fRecording then
      fApi.EndCommandBuffer(fCmd);
    fRecording := false;
    // flushed command buffers may still run: wait before their descriptor
    // sets and command buffers are reused
    if fFlushed and (fApi.DeviceWaitIdle(fDevice) <> VK_SUCCESS) then
      fBroken := true;
    fFlushed := false;
  finally
    DriverFpuLeave(fpu);
  end;
end;


{ TInferVkBuffer }

constructor TInferVkBuffer.Create(aOwner: TInferVulkan; aSize: TVkDeviceSize;
  aDevice: boolean);
var
  fpu: TDriverFpu;
begin
  inherited Create;
  fOwner := aOwner;
  fpu := DriverFpuEnter;
  try
    Open(aSize, aDevice);
  finally
    DriverFpuLeave(fpu);
  end;
end;

constructor TInferVkBuffer.CreateReadback(aOwner: TInferVulkan;
  aSize: TVkDeviceSize);
var
  fpu: TDriverFpu;
begin
  inherited Create;
  fOwner := aOwner;
  fReadback := true;
  fpu := DriverFpuEnter;
  try
    Open(aSize, false);
  finally
    DriverFpuLeave(fpu);
  end;
end;

procedure TInferVkBuffer.Open(aSize: TVkDeviceSize; aDevice: boolean);
const
  HOST = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT or VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
var
  aOwner: TInferVulkan;
  info: TVkBufferCreateInfo;
  req: TVkMemoryRequirements;
  alloc: TVkMemoryAllocateInfo;
  kind: integer;
begin
  aOwner := fOwner;
  // whole 4-byte words: a shader reads packed bytes through a uint view, and
  // the last word of 210-byte Q6_K blocks would otherwise lie out of range
  aSize := (aSize + 3) and not TVkDeviceSize(3);
  if aSize < 4 then
    aSize := 4;
  fSize := aSize;
  FillCharFast(info, SizeOf(info), 0);
  info.sType := VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
  info.size := aSize;
  info.usage := VK_BUFFER_USAGE_STORAGE_BUFFER_BIT or
    VK_BUFFER_USAGE_TRANSFER_SRC_BIT or VK_BUFFER_USAGE_TRANSFER_DST_BIT;
  info.sharingMode := VK_SHARING_MODE_EXCLUSIVE;
  aOwner.CheckNew(aOwner.fApi.CreateBuffer(aOwner.fDevice, @info, nil, fBuffer),
    fBuffer, 'vkCreateBuffer');
  aOwner.fApi.GetBufferMemoryRequirements(aOwner.fDevice, fBuffer, req);
  FillCharFast(alloc, SizeOf(alloc), 0);
  alloc.sType := VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
  alloc.allocationSize := req.size;
  kind := -1;
  if fReadback then
    kind := aOwner.TryMemoryType(req.memoryTypeBits,
      HOST or VK_MEMORY_PROPERTY_HOST_CACHED_BIT);
  if kind >= 0 then
    // cached host memory
  else if not aDevice then
    kind := aOwner.MemoryType(req.memoryTypeBits, HOST)
  else
  begin
    kind := -1;
    // one memory for host and device (integrated GPU, CPU implementation):
    // map it - a discrete GPU's host-visible device memory (a BAR window) is
    // left alone, it may be small
    if aOwner.DeviceType in [VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU,
                              VK_PHYSICAL_DEVICE_TYPE_CPU] then
      kind := aOwner.TryMemoryType(req.memoryTypeBits,
        VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT or HOST);
    if kind < 0 then
      kind := aOwner.TryMemoryType(req.memoryTypeBits,
        VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
    if kind < 0 then
      kind := aOwner.MemoryType(req.memoryTypeBits, HOST);
  end;
  alloc.memoryTypeIndex := kind;
  aOwner.CheckNew(aOwner.fApi.AllocateMemory(aOwner.fDevice, @alloc, nil, fMemory),
    fMemory, 'vkAllocateMemory');
  aOwner.Check(aOwner.fApi.BindBufferMemory(aOwner.fDevice, fBuffer, fMemory, 0),
    'vkBindBufferMemory');
  if aOwner.fMemory.memoryTypes[kind].propertyFlags and HOST = HOST then
    aOwner.CheckNew(aOwner.fApi.MapMemory(aOwner.fDevice, fMemory, 0, VK_WHOLE_SIZE,
      0, fMapped), fMapped, 'vkMapMemory');
end;

destructor TInferVkBuffer.Destroy;
var
  fpu: TDriverFpu;
begin
  fpu := DriverFpuEnter;
  try
    Close;
  finally
    DriverFpuLeave(fpu);
  end;
  inherited Destroy;
end;

procedure TInferVkBuffer.Close;
begin
  // after a Run that did not finish the device may still use it: leak it
  if (fOwner <> nil) and not fOwner.fBroken then
  begin
    if fMapped <> nil then
      fOwner.fApi.UnmapMemory(fOwner.fDevice, fMemory);
    if fBuffer <> 0 then
      fOwner.fApi.DestroyBuffer(fOwner.fDevice, fBuffer, nil);
    if fMemory <> 0 then
      fOwner.fApi.FreeMemory(fOwner.fDevice, fMemory, nil);
  end;
end;


{ TInferVkPipeline }

constructor TInferVkPipeline.Create(aOwner: TInferVulkan; aSpirv: PCardinal;
  aWords: PtrInt; aBuffers, aPushSize: integer);
var
  fpu: TDriverFpu;
begin
  inherited Create;
  fOwner := aOwner;
  if (aBuffers < 1) or (aBuffers > VK_MAX_BINDINGS) or (aPushSize < 0) or
     (aPushSize and 3 <> 0) or (aPushSize > 128) then
    raise EInferVulkan.CreateUtf8('Vulkan: pipeline of % buffers and % push bytes',
      [aBuffers, aPushSize]);
  fBuffers := aBuffers;
  fPushSize := aPushSize;
  fpu := DriverFpuEnter;
  try
    Open(aSpirv, aWords);
  finally
    DriverFpuLeave(fpu);
  end;
end;

procedure TInferVkPipeline.Open(aSpirv: PCardinal; aWords: PtrInt);
var
  aOwner: TInferVulkan;
  minfo: TVkShaderModuleCreateInfo;
  bindings: array[0..VK_MAX_BINDINGS - 1] of TVkDescriptorSetLayoutBinding;
  linfo: TVkDescriptorSetLayoutCreateInfo;
  push: TVkPushConstantRange;
  playout: TVkPipelineLayoutCreateInfo;
  cinfo: TVkComputePipelineCreateInfo;
  size: TVkDescriptorPoolSize;
  pinfo: TVkDescriptorPoolCreateInfo;
  ainfo: TVkDescriptorSetAllocateInfo;
  i: integer;
begin
  aOwner := fOwner;
  FillCharFast(minfo, SizeOf(minfo), 0);
  minfo.sType := VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
  minfo.codeSize := aWords * 4;
  minfo.pCode := aSpirv;
  aOwner.CheckNew(aOwner.fApi.CreateShaderModule(aOwner.fDevice, @minfo, nil,
    fModule), fModule, 'vkCreateShaderModule');
  FillCharFast(bindings, SizeOf(bindings), 0);
  for i := 0 to fBuffers - 1 do
  begin
    bindings[i].binding := i;
    bindings[i].descriptorType := VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
    bindings[i].descriptorCount := 1;
    bindings[i].stageFlags := VK_SHADER_STAGE_COMPUTE_BIT;
  end;
  FillCharFast(linfo, SizeOf(linfo), 0);
  linfo.sType := VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
  linfo.bindingCount := fBuffers;
  linfo.pBindings := @bindings;
  aOwner.CheckNew(aOwner.fApi.CreateDescriptorSetLayout(aOwner.fDevice, @linfo, nil,
    fSetLayout), fSetLayout, 'vkCreateDescriptorSetLayout');
  push.stageFlags := VK_SHADER_STAGE_COMPUTE_BIT;
  push.offset := 0;
  push.size := fPushSize;
  FillCharFast(playout, SizeOf(playout), 0);
  playout.sType := VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
  playout.setLayoutCount := 1;
  playout.pSetLayouts := @fSetLayout;
  if fPushSize > 0 then
  begin
    playout.pushConstantRangeCount := 1;
    playout.pPushConstantRanges := @push;
  end;
  aOwner.CheckNew(aOwner.fApi.CreatePipelineLayout(aOwner.fDevice, @playout, nil,
    fLayout), fLayout, 'vkCreatePipelineLayout');
  FillCharFast(cinfo, SizeOf(cinfo), 0);
  cinfo.sType := VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
  cinfo.stage.sType := VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
  cinfo.stage.stage := VK_SHADER_STAGE_COMPUTE_BIT;
  cinfo.stage.module := fModule;
  cinfo.stage.pName := 'main';
  cinfo.layout := fLayout;
  cinfo.basePipelineIndex := -1;
  aOwner.CheckNew(aOwner.fApi.CreateComputePipelines(aOwner.fDevice, 0, 1, @cinfo,
    nil, @fPipeline), fPipeline, 'vkCreateComputePipelines');
  size.descriptorType := VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
  size.descriptorCount := fBuffers;
  FillCharFast(pinfo, SizeOf(pinfo), 0);
  pinfo.sType := VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
  pinfo.maxSets := 1;
  pinfo.poolSizeCount := 1;
  pinfo.pPoolSizes := @size;
  aOwner.CheckNew(aOwner.fApi.CreateDescriptorPool(aOwner.fDevice, @pinfo, nil,
    fPool), fPool, 'vkCreateDescriptorPool');
  FillCharFast(ainfo, SizeOf(ainfo), 0);
  ainfo.sType := VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
  ainfo.descriptorPool := fPool;
  ainfo.descriptorSetCount := 1;
  ainfo.pSetLayouts := @fSetLayout;
  aOwner.Check(aOwner.fApi.AllocateDescriptorSets(aOwner.fDevice, @ainfo, @fSet),
    'vkAllocateDescriptorSets');
end;

destructor TInferVkPipeline.Destroy;
var
  fpu: TDriverFpu;
begin
  fpu := DriverFpuEnter;
  try
    Close;
  finally
    DriverFpuLeave(fpu);
  end;
  inherited Destroy;
end;

procedure TInferVkPipeline.Close;
var
  d: TVkDispatch;
begin
  // after a Run that did not finish the device may still use it: leak it
  if (fOwner <> nil) and not fOwner.fBroken then
  begin
    d := fOwner.fDevice;
    if fPool <> 0 then
      fOwner.fApi.DestroyDescriptorPool(d, fPool, nil); // frees fSet too
    if fPipeline <> 0 then
      fOwner.fApi.DestroyPipeline(d, fPipeline, nil);
    if fLayout <> 0 then
      fOwner.fApi.DestroyPipelineLayout(d, fLayout, nil);
    if fSetLayout <> 0 then
      fOwner.fApi.DestroyDescriptorSetLayout(d, fSetLayout, nil);
    if fModule <> 0 then
      fOwner.fApi.DestroyShaderModule(d, fModule, nil);
  end;
end;

end.
