    pQueuePriorities: PSingle;
  end;

  TVkDeviceCreateInfo = record
    sType: integer;
    pNext: pointer;
    flags: TVkFlags;
    queueCreateInfoCount: cardinal;
    pQueueCreateInfos: ^TVkDeviceQueueCreateInfo;
