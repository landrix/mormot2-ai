/// native inference engine - Vulkan compute: loader binding and device context
// - part of the mormot.ai.* extension (LandrixAI)
// - licensed under a MPL/GPL/LGPL three license - see LICENSE
// - phase 4a of docs/native-inference.md: only what compute needs (instance,
//   device, queue, buffers, compute pipelines, descriptor sets, command
//   buffers, fences), written after the Khronos headers: vulkan_core.h of
//   Vulkan-Headers tag vulkan-sdk-1.4.363.0, commit 6802bb4733b6 (MIT branch of
//   "Apache-2.0 OR MIT", see UPSTREAM_BASE and NOTICE); PasVulkan (commit
//   1467e9b27e02, header 346) looked up only; nothing is shipped - the driver's loader
//   (vulkan-1.dll, libvulkan.so.1) is loaded at run time, and without one
//   TInferVulkan.Available is false
// - shaders are SPIR-V constants (mormot.ai.infer.vulkan.spv.inc, generated by
//   tools/vk/build-shaders.sh): no shader compiler at build or run time
// - buffers live in host-visible coherent memory (mapped) or in device memory
//   (4b): on a discrete GPU the latter is not mapped and Upload / Download go
//   through a staging buffer; on an integrated GPU or a CPU implementation
//   device memory is host-visible too and is mapped instead
// - macOS through MoltenVK (Vulkan on Metal): the instance asks for
//   VK_KHR_portability_enumeration when the loader lists it (else MoltenVK
//   reports no device) and the device enables VK_KHR_portability_subset when
//   it lists it; the loader comes from the system (Vulkan SDK or Homebrew)
// - not yet: 32-bit FPC (the record layout relies on Int64 fields aligned
//   to 8 as MSVC does: Delphi's {$A8} does that, FPC i386 is no target)
unit mormot.ai.infer.vulkan;

{
  *****************************************************************************

    - the Vulkan types and entry points used for compute
    - TInferVulkan: one device and compute queue; TInferVkBuffer,
      TInferVkPipeline on it; Run records, submits and waits

  *****************************************************************************
}

interface

{$I mormot.defines.inc}

{$ifndef FPC}{$ifdef CPUX64}
  {$EXCESSPRECISION OFF} // single expressions in single, as FPC computes them
{$endif}{$endif}

uses
  sysutils,
  math,
  mormot.core.base,
  mormot.core.os,
  mormot.core.unicode,
  mormot.core.text,
  mormot.ai.infer.tensor;

{$ifdef FPC}
  {$packrecords C} // the C layout of the Vulkan structures
{$else}
  {$A8}
{$endif FPC}

type
  /// a Vulkan call failed, or no usable device
  EInferVulkan = class(EInferError);

  TVkResult = integer;
  TVkFlags = cardinal;
  TVkBool32 = cardinal;
  /// VkDeviceSize, an uint64_t (Int64 for Delphi 7)
  TVkDeviceSize = Int64;
  /// a dispatchable handle (VkInstance, VkDevice, VkQueue ...): a pointer
  TVkDispatch = pointer;
  /// a non-dispatchable handle (VkBuffer, VkPipeline ...): 64-bit everywhere
  TVkHandle = Int64;
  PVkHandle = ^TVkHandle;

  TVkApplicationInfo = record
    sType: integer;
    pNext: pointer;
    pApplicationName: PAnsiChar;
    applicationVersion: cardinal;
    pEngineName: PAnsiChar;
    engineVersion: cardinal;
    apiVersion: cardinal;
  end;

  /// VkPhysicalDeviceSubgroupProperties (Vulkan 1.1), chained to
  // TVkPhysicalDeviceProperties2
  TVkPhysicalDeviceSubgroupProperties = record
    sType: integer;
    pNext: pointer;
    subgroupSize: cardinal;
    supportedStages: TVkFlags;
    supportedOperations: TVkFlags;
    quadOperationsInAllStages: cardinal;
  end;

  /// VkPhysicalDeviceProperties2 (Vulkan 1.1): properties is a
  // VkPhysicalDeviceProperties (824 bytes), read by offset as in Open
  TVkPhysicalDeviceProperties2 = record
    sType: integer;
    pNext: pointer;
    properties: array[0..1023] of byte;
  end;

  /// VkExtensionProperties: extensionName[VK_MAX_EXTENSION_NAME_SIZE = 256]
  TVkExtensionProperties = record
    extensionName: array[0..255] of AnsiChar;
    specVersion: cardinal;
  end;
  TVkExtensionPropertiesDynArray = array of TVkExtensionProperties;

  /// VkLayerSettingEXT (VK_EXT_layer_settings): one setting of a layer or driver
  TVkLayerSettingEXT = record
    pLayerName: PAnsiChar;
    pSettingName: PAnsiChar;
    settingType: integer;
    valueCount: cardinal;
    pValues: pointer;
  end;

  /// VkLayerSettingsCreateInfoEXT, chained to VkInstanceCreateInfo
  TVkLayerSettingsCreateInfoEXT = record
    sType: integer;
    pNext: pointer;
    settingCount: cardinal;
    pSettings: ^TVkLayerSettingEXT;
  end;

  TVkInstanceCreateInfo = record
    sType: integer;
    pNext: pointer;
    flags: TVkFlags;
    pApplicationInfo: ^TVkApplicationInfo;
    enabledLayerCount: cardinal;
    ppEnabledLayerNames: pointer;
    enabledExtensionCount: cardinal;
    ppEnabledExtensionNames: pointer;
  end;

  TVkQueueFamilyProperties = record
    queueFlags: TVkFlags;
    queueCount: cardinal;
    timestampValidBits: cardinal;
    minImageTransferGranularity: array[0..2] of cardinal;
  end;

  TVkMemoryType = record
    propertyFlags: TVkFlags;
    heapIndex: cardinal;
  end;

  TVkMemoryHeap = record
    size: TVkDeviceSize;
    flags: TVkFlags;
  end;

  TVkPhysicalDeviceMemoryProperties = record
    memoryTypeCount: cardinal;
