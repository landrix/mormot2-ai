# LandrixAI demo provider config.
# Copy to .env (gitignored) and source it before running a demo. In WSL:
#   set -a; . shared/delphi/landrixai/demos/.env; set +a
#   shared/delphi/landrixai/bin/fpc/demos/llm-chat
#
# The API key is read from the environment ONLY - never commit it, it is never
# logged by the client or the demos.

# --- OpenAI ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-replace-me

# --- LiteLLM proxy (OpenAI-compatible, multi-provider) ---
# LLM_BASE_URL=http://your-litellm-host:4000/v1
# LLM_MODEL=gpt-4o-mini          # or any model your proxy routes
# LLM_API_KEY=sk-litellm-replace-me

# --- local Ollama (no key needed) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# (leave LLM_API_KEY unset -> no Authorization header)

# --- Anthropic (native Messages API, own wire) ---
# Used by the llm-anthropic demo (TAnthropicClient). It does NOT use the LLM_*
# OpenAI-wire vars above: auth is x-api-key + anthropic-version, so it reads its
# own ANTHROPIC_* vars. Endpoint + version are baked into AnthropicConfig.
# ANTHROPIC_API_KEY=sk-ant-replace-me
# ANTHROPIC_MODEL=claude-opus-4-8     # default if unset

# --- Vision demo (llm-vision) ---
# VISION_PROVIDER selects the client (same neutral request, only ILlmClient differs):
#   openai (default) -> uses the LLM_* vars above (vision model, e.g. gpt-4o-mini)
#   anthropic        -> uses the ANTHROPIC_* vars above (claude-opus-4-8 etc.)
# VISION_PROVIDER=openai
# Pick ONE image source; base64 is fully self-contained (no provider fetch):
# VISION_IMAGE_B64=...              # raw base64 (no data: prefix)
# VISION_IMAGE_MEDIA=image/png      # MIME for the base64 (default image/png)
# VISION_IMAGE_URL=https://...      # alternative: a public image URL to fetch
# (set neither -> a built-in default URL)
