# LandrixAI demo provider config.
# Copy to .env (gitignored) and source it before running a demo. In WSL:
#   set -a; . shared/delphi/landrixai/demos/.env; set +a
#   shared/delphi/landrixai/bin/fpc/demos/llm-chat
#
# The API key is read from the environment ONLY - never commit it, it is never
# logged by the client or the demos.

# --- OpenAI ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-replace-me

# --- LiteLLM proxy (OpenAI-compatible, multi-provider) ---
# LLM_BASE_URL=http://your-litellm-host:4000/v1
# LLM_MODEL=gpt-4o-mini          # or any model your proxy routes
# LLM_API_KEY=sk-litellm-replace-me

# --- local Ollama (no key needed) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# (leave LLM_API_KEY unset -> no Authorization header)
