// LandrixAI - y[o] = bias[o] + sum_i w[o, i] * x[i] for one token row of
// Q8_0, Q4_K or Q6_K weights: the decode form of linear8.comp (backlog B8)
// - same bindings and push constants as linear.comp; only rows = 1 and
//   dtype 2 (Q8_0), 3 (Q4_K) or 4 (Q6_K) reach it
//   (TInferVulkanBackend.LinearShape)
// - a work group of 128 = 4 groups of 32 invocations, one output feature per
//   group (four per group decoded 5 % slower on the M2 Pro: fewer work
//   groups); an invocation takes units of 32 consecutive weights - a Q8_0
//   block, a Q4_K sub-block, a quarter of a Q6_K half - reading their scales
//   once and their quants as whole words (shifted by 16 bits where they start
//   at 2 mod 4: a Q8_0 block at 0 mod 4, its quants follow a 2-byte scale; a
//   Q6_K block at 2 mod 4; Q4_K blocks are 4-aligned); linear8.comp reads the scales byte by byte for every 8
//   weights
// - the dequantization is that of InferRowToF32 (linear8.comp: weights8)
// - TInferVulkanBackend takes it on Apple GPUs only (UseMatvec): an RTX 5090
//   decodes faster with linear8.comp
// - the 32 partial sums of a feature are added in shared memory, or with
//   -DSUBGROUP (SPV_MATVEC8_<type>_SG) by subgroupClusteredAdd, under the same
//   conditions and lane mapping as linear8.comp
#version 450
#ifdef SUBGROUP
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#endif

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer BufW { uint w[]; };
layout(std430, binding = 1) readonly buffer BufX { vec4 x[]; };
layout(std430, binding = 2) readonly buffer BufB { float bias[]; };
layout(std430, binding = 3) writeonly buffer BufY { float y[]; };

// dtype: 2 = Q8_0, 3 = Q4_K, 4 = Q6_K (TInferVulkanBackend)
layout(push_constant) uniform Push {
  uint rows, nin, nout, dtype, hasBias;
  uint biasOff; // the first bias of the matrix (slice D5d2: an expert's row)
} p;

// built once per weight type (-DDTYPE=2/3/4): the code of the other types
// would cost registers (Q8_0 decoded 10 % slower from a shader for all three)
#ifdef DTYPE
#define DT DTYPE
#else
#define DT p.dtype
#endif

shared float partial[128];

// the 4 signed bytes of v times a
float dot4s(uint v, vec4 a)
{
  return float(bitfieldExtract(int(v), 0, 8)) * a.x +
         float(bitfieldExtract(int(v), 8, 8)) * a.y +
         float(bitfieldExtract(int(v), 16, 8)) * a.z +
         float(bitfieldExtract(int(v), 24, 8)) * a.w;
}

// the 4 nibbles at bit sh of the bytes of v times a
float dot4n(uint v, uint sh, vec4 a)
{
  return float((v >> sh) & 15u) * a.x +
         float((v >> (sh + 8u)) & 15u) * a.y +
         float((v >> (sh + 16u)) & 15u) * a.z +
         float((v >> (sh + 24u)) & 15u) * a.w;
}

// the 4 bytes from bit sh (0 or 16) of word i on: at 16 the halves of two
// words - without a branch (neighbour invocations alternate between both
// cases for Q8_0 and Q6_K), and without a read past the word of the last byte
uint wordAt(uint i, uint sh)
{
  return (w[i] >> sh) | ((w[i + (sh >> 4)] << 16) << (16u - sh));
}

// the 4 bytes at the even byte address a as a word
uint word2(uint a)
{
  return wordAt(a >> 2, (a & 2u) * 8u);
}

// the 2 bytes at the even byte address a (never past their own word)
uint half16(uint a)
{
  return (w[a >> 2] >> ((a & 2u) * 8u)) & 0xffffu;
}

// byte k of the little-endian words s0 s1 s2
uint byte12(uint s0, uint s1, uint s2, uint k)
{
  uint v = k < 4u ? s0 : (k < 8u ? s1 : s2);
  return (v >> ((k & 3u) * 8u)) & 255u;
}

// unit u (32 weights) of the row at byte rowBase times its activations xv
float unitDot(uint rowBase, uint u, vec4 xv[8])
{
  float s = 0.0;
  if (DT == 2u)
  {
    // Q8_0: 34 bytes per 32 values, value = d * qs[j]
    uint a = rowBase + u * 34u;
    float d = unpackHalf2x16(half16(a)).x;
    // the quants from byte a + 2 on: word qi, bit qs; not word2(a + 2u + 4u *
    // k) - the Adreno X1-85 compiler took (a + 2 + 4 k) >> 2 for
    // (a >> 2) + k, losing the carry where a is 2 mod 4 (backlog B10)
    uint qi = (a >> 2) + ((a >> 1) & 1u);
    uint qs = 16u - (a & 2u) * 8u;
    for (uint k = 0u; k < 8u; k++)
      s += dot4s(wordAt(qi + k, qs), xv[k]);
    return d * s;
  }
  else if (DT == 3u)
  {
    // Q4_K: 144 bytes per 256 values (InferScaleMinK4, DequantQ4K); sub-block
    // j of block u / 8: value = d * sc * q - dmin * m
    uint i = (rowBase + (u >> 3) * 144u) >> 2;
    uint j = u & 7u;
    vec2 dm = unpackHalf2x16(w[i]);
    uint s0 = w[i + 1u];
    uint s1 = w[i + 2u];
    uint s2 = w[i + 3u];
    uint sc, m;
    if (j < 4u)
    {
      sc = byte12(s0, s1, s2, j) & 63u;
      m = byte12(s0, s1, s2, j + 4u) & 63u;
    }
    else
    {
      sc = (byte12(s0, s1, s2, j + 4u) & 15u) |
           ((byte12(s0, s1, s2, j - 4u) >> 6) << 4);
      m = (byte12(s0, s1, s2, j + 4u) >> 4) | ((byte12(s0, s1, s2, j) >> 6) << 4);
    }
    // the quants: 32 bytes at 16 + 32 * (j / 2), nibble j % 2
    uint qi = i + 4u + 8u * (j >> 1);
    uint sh = (j & 1u) * 4u;
    float sx = 0.0;
    for (uint k = 0u; k < 8u; k++)
    {
      s += dot4n(w[qi + k], sh, xv[k]);
      sx += xv[k].x + xv[k].y + xv[k].z + xv[k].w;
    }
    return dm.x * float(sc) * s - dm.y * float(m) * sx;
  }
  else
  {
    // Q6_K: 210 bytes per 256 values - ql[128], qh[64], scales[16], d
    // (Q6KValue); unit uu = u % 8 of block u / 8: the values 32 uu .. 32 uu +
    // 31 of half uu / 4, quarter uu % 4, under two scales of 16 values
    uint base = rowBase + (u >> 3) * 210u;
    uint uu = u & 7u;
    uint n = uu >> 2;
    uint quarter = uu & 3u;
    uint la = base + 64u * n + ((quarter & 1u) != 0u ? 32u : 0u);
    uint ha = base + 128u + 32u * n;
    uint lsh = quarter >= 2u ? 4u : 0u;
    uint hsh = 2u * quarter;
    uint scw = half16(base + 192u + 2u * uu); // the two int8 scales
    float d = unpackHalf2x16(half16(base + 208u)).x;
    float s1 = 0.0;
    for (uint k = 0u; k < 8u; k++)
    {
      // per byte: q = (ql nibble) | (2 bits of qh) << 4, value q - 32
      uint q = ((word2(la + 4u * k) >> lsh) & 0x0f0f0f0fu) |
               (((word2(ha + 4u * k) >> hsh) & 0x03030303u) << 4);
      vec4 a = xv[k];
      float v = (float(q & 255u) - 32.0) * a.x +
                (float((q >> 8) & 255u) - 32.0) * a.y +
                (float((q >> 16) & 255u) - 32.0) * a.z +
                (float(q >> 24) - 32.0) * a.w;
      if (k < 4u)
        s += v;
      else
        s1 += v;
    }
    return d * (float(bitfieldExtract(int(scw), 0, 8)) * s +
                float(bitfieldExtract(int(scw), 8, 8)) * s1);
  }
}

void main()
{
  uint t = gl_LocalInvocationID.x;
  uint lane = t & 31u;
  uint group = t >> 5;
  bool sg = false;
#ifdef SUBGROUP
  if ((gl_SubgroupSize >= 32u) && (gl_NumSubgroups * gl_SubgroupSize == 128u))
  {
    sg = true;
    lane = gl_SubgroupInvocationID & 31u;
    group = gl_SubgroupID * (gl_SubgroupSize >> 5) + (gl_SubgroupInvocationID >> 5);
  }
#endif
  uint units = p.nin >> 5;
  uint rowBytes;
  if (DT == 2u)
    rowBytes = units * 34u;
  else if (DT == 3u)
    rowBytes = (p.nin >> 8) * 144u;
  else
    rowBytes = (p.nin >> 8) * 210u;
  for (uint ob = gl_WorkGroupID.x * 4u; ob < p.nout; ob += gl_NumWorkGroups.x * 4u)
  {
    uint o = ob + group;
    float acc = 0.0;
    if (o < p.nout)
      for (uint u = lane; u < units; u += 32u)
      {
        vec4 xv[8];
        for (uint k = 0u; k < 8u; k++)
          xv[k] = x[u * 8u + k];
        acc += unitDot(o * rowBytes, u, xv);
      }
#ifdef SUBGROUP
    if (sg)
    {
      float v = subgroupClusteredAdd(acc, 32u);
      if ((lane == 0u) && (o < p.nout))
      {
        float b = 0.0;
        if (p.hasBias != 0u)
          b = bias[p.biasOff + o];
        y[o] = v + b;
      }
    }
    else
#endif
    {
      partial[t] = acc;
      barrier();
      for (uint h = 16u; h > 0u; h >>= 1)
      {
        if (lane < h)
          partial[t] += partial[t + h];
        barrier();
      }
      if ((lane == 0u) && (o < p.nout))
      {
        float b = 0.0;
        if (p.hasBias != 0u)
          b = bias[p.biasOff + o];
        y[o] = partial[t] + b;
      }
      barrier(); // partial[] is reused for the next features
    }
  }
}
