// LandrixAI - y[i] = sum over the k slots, in slot (= expert id) order, of
// w[s] * d[s, i]: the outputs of the experts a route shader chose, summed with
// their weights - the arithmetic of fill0.comp followed by one scatteradd.comp
// per expert (phase D of docs/native-inference.md, slice D3c)
#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer BufD { float d[]; };
layout(std430, binding = 1) readonly buffer BufW { float w[]; };
layout(std430, binding = 2) writeonly buffer BufY { float y[]; };

layout(push_constant) uniform Push { uint k; uint n; } p;

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i >= p.n)
    return;
  float acc = 0.0;
  for (uint s = 0u; s < p.k; s++)
    acc = acc + w[s] * d[s * p.n + i];
  y[i] = acc;
}
