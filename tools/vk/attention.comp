// LandrixAI - causal attention with grouped-query heads on the device (phase 4c
// of docs/native-inference.md; CausalRows of the CPU backend in float)
// - y[r, h] = softmax(q[r, h] . keys[0 .. past + r] / sqrt(d)) . values, the
//   keys and values of the KV head h / (heads / kvHeads), rows at kvWidth
// - headDim a multiple of 4 and at most 256 (the queries are kept in shared
//   memory as vec4, the keys read as vec4; each invocation owns the output
//   dimensions t and t + 128)
// - phase 4e, flash attention: one work group of 128 per (head block, row
//   block, split); a block holds up to MAXQ queries - headBlock heads of one
//   KV head times rowBlock rows - so every key and value read serves all of
//   them; the keys go by in tiles of 128, their scores stay in shared memory
//   and the softmax is kept online (running maximum, sums rescaled)
// - the keys of a row are cut into splits ranges (flash-decoding), so a single
//   decoded token still fills the device; splits = 1: y is written normalized;
//   splits > 1: each range writes its unnormalized sums, its maximum and its
//   sum of exponentials to part[], and attnmerge.comp combines them into y
// - shared memory: 16 KB, the least every device offers
// - -DKVF16 (SPV_ATTENTION_F16): keys and values as half floats, two to a
//   word (qkrope.comp -DKVF16), read through key4() and val()
// - window > 0 (backlog D4b): row r sees only the keys past + r - window + 1 ..
//   past + r; the cache holds every row, the ranges start at the window
// - a work group sums the values of all keys lo .. hi of its queries, those
//   outside a query's range with a weight of 0 - and 0 times a NaN or infinite
//   value is NaN: a layer with a window therefore runs one row per work group
//   (TQwen3Vulkan), where every query shares one range; at the causal edge of
//   a prompt chunk the earlier rows of a group still sum the later rows'
//   values with a weight of 0, as since phase 4c
#version 450

#define MAXQ 8
#define NEG -3.402823e38

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer BufQ { float q[]; };
#ifdef KVF16
layout(std430, binding = 1) readonly buffer BufK { uvec2 keys4[]; };
layout(std430, binding = 2) readonly buffer BufV { uint vals[]; };
#else
layout(std430, binding = 1) readonly buffer BufK { vec4 keys4[]; };
layout(std430, binding = 2) readonly buffer BufV { float vals[]; };
#endif
layout(std430, binding = 3) writeonly buffer BufY { float y[]; };
// [heads, rows, splits, headDim + 2]: the sums, then max and sum of exp
layout(std430, binding = 4) writeonly buffer BufP { float part[]; };

// headBlock divides heads / kvHeads, headBlock * rowBlock <= MAXQ
layout(push_constant) uniform Push {
  uint rows, heads, headDim, kvHeads, past, splits, headBlock, rowBlock;
  uint window; // > 0: a row sees only its last window keys, itself included
} p;

shared vec4 qs[MAXQ * 64];      // the queries
shared float ps[MAXQ * 128];    // the scores, then the weights of a tile
shared float red[MAXQ * 128];   // the maximum of a tile

// the 4 key values from vec4 slot i, value i
#ifdef KVF16
vec4 key4(uint i)
{
  uvec2 u = keys4[i];
  return vec4(unpackHalf2x16(u.x), unpackHalf2x16(u.y));
}

float val(uint i)
{
  vec2 v = unpackHalf2x16(vals[i >> 1]);
  return (i & 1u) != 0u ? v.y : v.x;
}
#else
vec4 key4(uint i)
{
  return keys4[i];
}

float val(uint i)
{
  return vals[i];
}
#endif

void main()
{
  uint t = gl_LocalInvocationID.x;
  uint hb = p.headBlock;
  uint h0 = gl_WorkGroupID.x * hb;
  uint r0 = gl_WorkGroupID.y * p.rowBlock;
  uint s = gl_WorkGroupID.z;
  uint d = p.headDim;
  uint d4 = d >> 2;
  uint kvw = p.kvHeads * d;
  uint qw = p.heads * d;
  uint g = h0 / (p.heads / p.kvHeads);
  // query i: head h0 + i % hb, row r0 + i / hb
  uint nq = hb * min(p.rowBlock, p.rows - r0);
  float scale = 1.0 / sqrt(float(d));
  for (uint i = t; i < nq * d4; i += 128u)
  {
    uint qi = i / d4;
    uint k = i - qi * d4;
    uint qb = (r0 + qi / hb) * qw + (h0 + qi % hb) * d + 4u * k;
    qs[qi * 64u + k] = vec4(q[qb], q[qb + 1u], q[qb + 2u], q[qb + 3u]);
  }
  // the keys j0 .. j1 - 1 of each query in this split (empty for a late
  // split of an early row); both grow with the row, the block reads lo .. hi
  uint j0[MAXQ], j1[MAXQ];
  uint lo = 0xffffffffu;
  uint hi = 0u;
  for (uint i = 0u; i < MAXQ; i++)
  {
    j0[i] = 0u;
    j1[i] = 0u;
    if (i < nq)
    {
      uint total = p.past + r0 + i / hb + 1u;
      // a sliding window: the keys before the last window ones are not read
      uint first = (p.window != 0u) && (total > p.window) ? total - p.window : 0u;
      uint chunk = (total - first + p.splits - 1u) / p.splits;
      j0[i] = min(total, first + s * chunk);
      j1[i] = min(total, j0[i] + chunk);
      lo = min(lo, j0[i]);
      hi = max(hi, j1[i]);
    }
  }
  barrier();
  float m[MAXQ], l[MAXQ], acc0[MAXQ], acc1[MAXQ];
  for (uint i = 0u; i < MAXQ; i++)
  {
    m[i] = NEG;
    l[i] = 0.0;
    acc0[i] = 0.0;
    acc1[i] = 0.0;
  }
  uint vk = g * d + t;
  for (uint base = lo; base < hi; base += 128u)
  {
    // the scores of key base + t
    uint j = base + t;
    float sv[MAXQ];
    for (uint i = 0u; i < MAXQ; i++)
      sv[i] = 0.0;
    if (j < hi)
    {
      uint kb = (j * kvw + g * d) >> 2;
      for (uint k = 0u; k < d4; k++)
      {
        vec4 kv = key4(kb + k);
        for (uint i = 0u; i < MAXQ; i++)
          if (i < nq)
            sv[i] += dot(qs[i * 64u + k], kv);
      }
    }
    for (uint i = 0u; i < MAXQ; i++)
    {
      float v = NEG;
      if ((i < nq) && (j >= j0[i]) && (j < j1[i]))
        v = sv[i] * scale;
      ps[i * 128u + t] = v;
      red[i * 128u + t] = v;
    }
    barrier();
    for (uint w = 64u; w > 0u; w >>= 1)
    {
      if (t < w)
        for (uint i = 0u; i < MAXQ; i++)
          red[i * 128u + t] = max(red[i * 128u + t], red[i * 128u + t + w]);
      barrier();
    }
    // the new maxima: the sums so far rescaled, the weights of this tile
    for (uint i = 0u; i < MAXQ; i++)
    {
      float mn = max(m[i], red[i * 128u]);
      float f = exp(m[i] - mn);
      acc0[i] *= f;
      acc1[i] *= f;
      l[i] *= f;
      m[i] = mn;
      float e = 0.0;
      if ((i < nq) && (j >= j0[i]) && (j < j1[i]))
        e = exp(ps[i * 128u + t] - mn);
      ps[i * 128u + t] = e;
    }
    barrier();
    // the weighted values of this tile
    uint n = min(128u, hi - base);
    for (uint jj = 0u; jj < n; jj++)
    {
      uint vb = (base + jj) * kvw + vk;
      float v0 = 0.0;
      float v1 = 0.0;
      if (t < d)
        v0 = val(vb);
      if (t + 128u < d)
        v1 = val(vb + 128u);
      for (uint i = 0u; i < MAXQ; i++)
      {
        float w = ps[i * 128u + jj];
        l[i] += w;
        acc0[i] += w * v0;
        acc1[i] += w * v1;
      }
    }
    barrier(); // ps and red are refilled by the next tile
  }
  for (uint i = 0u; i < MAXQ; i++)
    if (i < nq)
    {
      uint h = h0 + i % hb;
      uint r = r0 + i / hb;
      if (p.splits == 1u)
      {
        uint yb = r * qw + h * d + t;
        if (t < d)
          y[yb] = acc0[i] / l[i];
        if (t + 128u < d)
          y[yb + 128u] = acc1[i] / l[i];
      }
      else
      {
        uint pb = ((h * p.rows + r) * p.splits + s) * (d + 2u);
        if (t < d)
          part[pb + t] = acc0[i];
        if (t + 128u < d)
          part[pb + t + 128u] = acc1[i];
        if (t == 0u)
        {
          part[pb + d] = m[i];
          part[pb + d + 1u] = l[i];
        }
      }
    }
}
