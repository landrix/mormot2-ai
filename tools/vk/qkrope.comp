// LandrixAI - the per-head part of a Qwen3 attention block in one dispatch
// (phase 4e of docs/native-inference.md): for every token row and head,
// RMSNorm of q (QNorm) and k (KNorm) when norm is set (Qwen3; Qwen2 has
// none: then qn and kn are not read), rotary positions on both unless rope is
// 0 (a NoPE layer, backlog D4b: q and k pass unrotated), and k and v
// stored into the KV cache at position past + row - what were six dispatches
// (two norms, two RoPE, two copies); arithmetic as rmsnorm.comp and rope.comp
// - one work group of 128 per (row, head): heads first, then the KV heads
// (which also store v); headDim <= 256, even
// - rot: the first rot values of a head rotate (rotate_half within them, cs
//   holds rot / 2 per row), the others pass as normed (Qwen3.5, slice D7e2);
//   0: all of them
// - -DKVF16 (SPV_QKROPE_F16): the cache holds k and v as half floats, two to
//   a word (packHalf2x16: core GLSL, no 16-bit storage extension), each
//   invocation storing whole words; headDim then a multiple of 4
#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer BufQ { float q[]; };
layout(std430, binding = 1) readonly buffer BufK { float k[]; };
layout(std430, binding = 2) readonly buffer BufV { float v[]; };
layout(std430, binding = 3) readonly buffer BufQN { float qn[]; };
layout(std430, binding = 4) readonly buffer BufKN { float kn[]; };
layout(std430, binding = 5) readonly buffer BufCS { float cs[]; }; // cos, then sin
#ifdef KVF16
layout(std430, binding = 6) writeonly buffer BufKC { uint kc[]; };
layout(std430, binding = 7) writeonly buffer BufVC { uint vc[]; };
#else
layout(std430, binding = 6) writeonly buffer BufKC { float kc[]; };
layout(std430, binding = 7) writeonly buffer BufVC { float vc[]; };
#endif

layout(push_constant) uniform Push {
  uint rows, heads, kvHeads, headDim, past;
  float eps;
  uint norm;
  uint rope; // 0: no rotary positions in this layer (NoPE), q and k as they are
  uint rot; // the rotated share of a head, 0: all of it
} p;

shared float partial[128];
shared float normed[256];

void main()
{
  uint t = gl_LocalInvocationID.x;
  uint r = gl_WorkGroupID.y;
  uint hh = gl_WorkGroupID.x; // 0 .. heads + kvHeads - 1
  uint d = p.headDim;
  uint half_ = (p.rot == 0u ? d : p.rot) >> 1;
  bool isQ = hh < p.heads;
  uint h = isQ ? hh : hh - p.heads;
  uint src = isQ ? (r * p.heads + h) * d : (r * p.kvHeads + h) * d;
  // the sum of squares of the head
  float s = 0.0;
  for (uint c = t; c < d; c += 128u)
  {
    float a = isQ ? q[src + c] : k[src + c];
    s += a * a;
  }
  partial[t] = s;
  barrier();
  for (uint w = 64u; w > 0u; w >>= 1)
  {
    if (t < w)
      partial[t] += partial[t + w];
    barrier();
  }
  float inv = inversesqrt(partial[0] / float(d) + p.eps);
  for (uint c = t; c < d; c += 128u)
  {
    float a = isQ ? q[src + c] : k[src + c];
    normed[c] = p.norm != 0u ? (isQ ? qn[c] : kn[c]) * (a * inv) : a;
  }
  barrier();
  // rotary positions: the halves rotated by the factors of the row
  uint cbase = r * half_;
  uint sbase = p.rows * half_ + r * half_;
  uint kvw = p.kvHeads * d;
  uint dst = (p.past + r) * kvw + h * d;
#ifdef KVF16
  if (!isQ)
  {
    // a word of two values each (the cache words of a head start at an even
    // index): every value rotated within the share on its own, so that rot / 2
    // may be odd too
    for (uint c = 2u * t; c < d; c += 256u)
    {
      vec2 o;
      for (uint e = 0u; e < 2u; e++)
      {
        uint j = c + e;
        float x = normed[j];
        if ((p.rope != 0u) && (j < 2u * half_))
        {
          uint i = j < half_ ? j : j - half_;
          float cv = cs[cbase + i];
          float sv = cs[sbase + i];
          x = j < half_ ? normed[j] * cv - normed[j + half_] * sv
                        : normed[j] * cv + normed[i] * sv;
        }
        o[e] = x;
      }
      kc[(dst + c) >> 1] = packHalf2x16(o);
    }
    for (uint c = 2u * t; c < d; c += 256u)
      vc[(dst + c) >> 1] = packHalf2x16(vec2(v[src + c], v[src + c + 1u]));
    return;
  }
#endif
  for (uint i = t; i < half_; i += 128u)
  {
    float a = normed[i];
    float b = normed[i + half_];
    float x0 = a;
    float x1 = b;
    if (p.rope != 0u)
    {
      float c = cs[cbase + i];
      float sn = cs[sbase + i];
      x0 = a * c - b * sn;
      x1 = b * c + a * sn;
    }
    if (isQ)
    {
      q[src + i] = x0;
      q[src + i + half_] = x1;
    }
#ifndef KVF16
    else
    {
      kc[dst + i] = x0;
      kc[dst + i + half_] = x1;
    }
#endif
  }
  // beyond the rotated share: as normed
  for (uint c = 2u * half_ + t; c < d; c += 128u)
    if (isQ)
      q[src + c] = normed[c];
#ifndef KVF16
    else
      kc[dst + c] = normed[c];
  if (!isQ)
    for (uint c = t; c < d; c += 128u)
      vc[dst + c] = v[src + c];
#endif
}
