// LandrixAI - y[r, o] = bias[o] + sum_i w[o, i] * x[r, i], the fast form of
// linear.comp (phase 4e of docs/native-inference.md)
// - same bindings, push constants and arithmetic contract as linear.comp: w in
//   its storage type (F32, Q8_0, Q4_K, Q6_K, Q5_0, MXFP4), dequantized as
//   InferRowToF32, times F32 activations - only the summation order differs
// - a work group of 128 = 4 output features x 32 invocations; each invocation
//   dequantizes 8 consecutive weights per step of 256 inputs (whole words
//   loaded, bytes taken from registers) and multiplies them with up to ROWS
//   token rows, so prefill reuses every dequantized weight ROWS times
// - needs nin to be a multiple of 8 (F32) / 32 (Q8_0, Q5_0) / 256 (K-quants):
//   the backend falls back to linear.comp otherwise
// - built twice (tools/vk/build-shaders.sh): as is for Vulkan 1.0, the 32
//   partial sums of a feature added in shared memory; with -DSUBGROUP for
//   Vulkan 1.1 (SPV_LINEAR8_SG), added by subgroupClusteredAdd without a
//   barrier - only for subgroups of at least 32 invocations with clustered
//   arithmetic in compute shaders (TInferVulkanBackend checks)
// - Vulkan relates no local invocation id to a subgroup lane: the subgroup
//   path takes lane and feature from gl_SubgroupID / gl_SubgroupInvocationID
//   (a cluster is 32 consecutive subgroup invocations), and only with full
//   subgroups of at least 32 (a device that runs smaller or partial ones
//   than it reports sums in shared memory also in this build; both values
//   are the same for the whole work group)
// - with -DIDS (SPV_LINEAR8_IDS, _IDS_SG; slice D3c): one token row through
//   the k experts a route shader chose - work group y is slot s, its expert
//   id ids[s] (binding 4), the expert's matrix at byte ids[s] * stride of w
//   (the experts of a layer one buffer); x is row s when xslot, else row 0;
//   y receives row s. The arithmetic of one row of the plain build
#version 450
#ifdef SUBGROUP
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#endif

#define ROWS 8

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer BufW { uint w[]; };
layout(std430, binding = 1) readonly buffer BufX { vec4 x[]; };
layout(std430, binding = 2) readonly buffer BufB { float bias[]; };
layout(std430, binding = 3) writeonly buffer BufY { float y[]; };
#ifdef IDS
layout(std430, binding = 4) readonly buffer BufI { int ids[]; };
#endif

// dtype: 1 = F32, 2 = Q8_0, 3 = Q4_K, 4 = Q6_K, 5 = Q5_0, 6 = MXFP4
// (TInferVulkanBackend)
layout(push_constant) uniform Push {
  uint rows, nin, nout, dtype, hasBias;
#ifdef IDS
  uint stride, xslot; // the bias of slot s: row ids[s] of [experts, nout]
#else
  uint biasOff; // the first bias of the matrix (slice D5d2: an expert's row)
#endif
} p;

// the bias of feature o
uint biasAt(uint o)
{
#ifdef IDS
  return uint(ids[gl_WorkGroupID.y]) * p.nout + o;
#else
  return p.biasOff + o;
#endif
}

shared float partial[ROWS * 128];

uint byteAt(uint a)
{
  return (w[a >> 2] >> ((a & 3u) * 8u)) & 255u;
}

// 8 bytes from byte address a (any alignment) into two words, little-endian
uvec2 bytes8(uint a)
{
  uint s = (a & 3u) * 8u;
  uint i = a >> 2;
  uint w0 = w[i];
  uint w1 = w[i + 1u];
  if (s == 0u)
    return uvec2(w0, w1);
  uint w2 = w[i + 2u];
  return uvec2((w0 >> s) | (w1 << (32u - s)), (w1 >> s) | (w2 << (32u - s)));
}

float halfAt(uint a)
{
  return unpackHalf2x16(byteAt(a) | (byteAt(a + 1u) << 8)).x;
}

// signed byte k (0..3) of v
float s8(uint v, uint k)
{
  return float(bitfieldExtract(int(v), int(k * 8u), 8));
}

// unsigned byte k (0..3) of v
uint u8(uint v, uint k)
{
  return (v >> (k * 8u)) & 255u;
}

// MXFP4 (slice D5d2): ggml's block_mxfp4 - kvalues_mxfp4 (the E2M1 values
// doubled) times E8M0_TO_FP32_HALF(e) = 2^(e - 128), subnormal below e = 2
const float KV_MXFP4[16] = float[16](0.0, 1.0, 2.0, 3.0, 4.0, 6.0, 8.0, 12.0,
  0.0, -1.0, -2.0, -3.0, -4.0, -6.0, -8.0, -12.0);

float e8m0Half(uint e)
{
  return uintBitsToFloat(e < 2u ? (0x00200000u << e) : ((e - 1u) << 23));
}

// the 8 weights e .. e + 7 of the row that starts at byte rowBase
void weights8(uint rowBase, uint e, out float wv[8])
{
  if (p.dtype == 1u)
  {
    uint i = (rowBase >> 2) + e;
    for (uint k = 0u; k < 8u; k++)
      wv[k] = uintBitsToFloat(w[i + k]);
  }
  else if (p.dtype == 2u)
  {
    // Q8_0: 34 bytes per 32 values, value = d * qs[j]; 8 values in one block
    uint base = rowBase + (e >> 5) * 34u;
    float d = halfAt(base);
    uvec2 q = bytes8(base + 2u + (e & 31u));
    for (uint k = 0u; k < 4u; k++)
    {
      wv[k] = d * s8(q.x, k);
      wv[k + 4u] = d * s8(q.y, k);
    }
  }
  else if (p.dtype == 3u)
  {
    // Q4_K: 144 bytes per 256 values (InferScaleMinK4, DequantQ4K); the 8
    // values lie in sub-block j
    uint base = rowBase + (e >> 8) * 144u;
    uint k8 = e & 255u;
    uint j = k8 >> 5;
    uint sc, m;
    if (j < 4u)
    {
      sc = byteAt(base + 4u + j) & 63u;
      m = byteAt(base + 8u + j) & 63u;
    }
    else
    {
      sc = (byteAt(base + 8u + j) & 15u) | ((byteAt(base + j) >> 6) << 4);
      m = (byteAt(base + 8u + j) >> 4) | ((byteAt(base + 4u + j) >> 6) << 4);
    }
    float d1 = halfAt(base) * float(sc);
    float m1 = halfAt(base + 2u) * float(m);
    // 16 + 32 * (j / 2) + (k8 & 31): a multiple of 8, the block 4-aligned
    uint qi = (base + 16u + 32u * (j >> 1) + (k8 & 31u)) >> 2;
    uint q0 = w[qi];
    uint q1 = w[qi + 1u];
    uint sh = (j & 1u) * 4u;
    for (uint k = 0u; k < 4u; k++)
    {
      wv[k] = d1 * float((u8(q0, k) >> sh) & 15u) - m1;
      wv[k + 4u] = d1 * float((u8(q1, k) >> sh) & 15u) - m1;
    }
  }
  else if (p.dtype == 6u)
  {
    // MXFP4: 17 bytes per 32 values - e, qs[16]; value j is kvalues[q] *
    // 2^(e - 128), q the low nibble of qs[j] below 16, the high one from 16;
    // 8 values in one block
    uint base = rowBase + (e >> 5) * 17u;
    uint j = e & 31u;
    uint eb = byteAt(base);
    float d = e8m0Half(eb);
    uvec2 q = bytes8(base + 1u + (j & 15u));
    uint sh = j >= 16u ? 4u : 0u;
    for (uint k = 0u; k < 4u; k++)
    {
      float a = KV_MXFP4[(u8(q.x, k) >> sh) & 15u];
      float b = KV_MXFP4[(u8(q.y, k) >> sh) & 15u];
      // e < 2: the scale is subnormal, and Vulkan may flush a subnormal
      // operand (no DenormPreserve) - ldexp scales without one, its exponent
      // kept at -126 or above (below, SPIR-V lets it flush too): a * 0.25 is
      // exact for every value of the table
      wv[k] = eb < 2u ? ldexp(a * 0.25, int(eb) - 126) : d * a;
      wv[k + 4u] = eb < 2u ? ldexp(b * 0.25, int(eb) - 126) : d * b;
    }
  }
  else if (p.dtype == 5u)
  {
    // Q5_0: 22 bytes per 32 values - d, qh[4], qs[16]; value = d * (q - 16)
    // with the low 4 bits of value j in qs[j & 15] (low nibble below 16,
    // high from 16) and its fifth bit bit j of qh; 8 values in one block -
    // the 8 fifth bits are one byte of qh (the Adreno X1-85 driver computed
    // wrong bits from the whole qh word shifted by j)
    uint base = rowBase + (e >> 5) * 22u;
    uint j = e & 31u;
    float d = halfAt(base);
    uint hb = byteAt(base + 2u + (j >> 3));
    uvec2 q = bytes8(base + 6u + (j & 15u));
    uint sh = j >= 16u ? 4u : 0u;
    for (uint k = 0u; k < 4u; k++)
    {
      wv[k] = d * float(int(((u8(q.x, k) >> sh) & 15u) | (((hb >> k) & 1u) << 4)) - 16);
      wv[k + 4u] = d * float(int(((u8(q.y, k) >> sh) & 15u) |
        (((hb >> (k + 4u)) & 1u) << 4)) - 16);
    }
  }
  else
  {
    // Q6_K: 210 bytes per 256 values - ql[128], qh[64], scales[16], d
    // (Q6KValue); the 8 values share one scale (a group of 16)
    uint base = rowBase + (e >> 8) * 210u;
    uint k8 = e & 255u;
    uint n = k8 >> 7;
    uint ii = k8 & 127u;
    uint l = ii & 31u;
    uint quarter = ii >> 5;
    uvec2 ql = bytes8(base + 64u * n + l + ((quarter & 1u) != 0u ? 32u : 0u));
    uvec2 qh = bytes8(base + 128u + 32u * n + l);
    uint lsh = quarter >= 2u ? 4u : 0u;
    uint hsh = 2u * quarter;
    float t = halfAt(base + 208u) * float(bitfieldExtract(int(byteAt(base + 192u +
      (k8 >> 4))), 0, 8));
    for (uint k = 0u; k < 4u; k++)
    {
      int a = int(((u8(ql.x, k) >> lsh) & 15u) | (((u8(qh.x, k) >> hsh) & 3u) << 4)) - 32;
      int b = int(((u8(ql.y, k) >> lsh) & 15u) | (((u8(qh.y, k) >> hsh) & 3u) << 4)) - 32;
      wv[k] = t * float(a);
      wv[k + 4u] = t * float(b);
    }
  }
}

void main()
{
  uint t = gl_LocalInvocationID.x;
  uint lane = t & 31u;
  uint group = t >> 5;
  bool sg = false;
#ifdef SUBGROUP
  if ((gl_SubgroupSize >= 32u) && (gl_NumSubgroups * gl_SubgroupSize == 128u))
  {
    sg = true;
    lane = gl_SubgroupInvocationID & 31u;
    group = gl_SubgroupID * (gl_SubgroupSize >> 5) + (gl_SubgroupInvocationID >> 5);
  }
#endif
#ifdef IDS
  // one row: x row xrow, y row r0 (the slot), the weights from wbase
  uint r0 = gl_WorkGroupID.y;
  uint nr = 1u;
  uint xrow = p.xslot != 0u ? r0 : 0u;
  uint wbase = uint(ids[r0]) * p.stride;
#else
  uint r0 = gl_WorkGroupID.y * ROWS;
  uint nr = min(uint(ROWS), p.rows - r0);
  uint xrow = r0;
  uint wbase = 0u;
#endif
  uint rowBytes;
  if (p.dtype == 1u)
    rowBytes = p.nin * 4u;
  else if (p.dtype == 2u)
    rowBytes = (p.nin >> 5) * 34u;
  else if (p.dtype == 3u)
    rowBytes = (p.nin >> 8) * 144u;
  else if (p.dtype == 5u)
    rowBytes = (p.nin >> 5) * 22u;
  else if (p.dtype == 6u)
    rowBytes = (p.nin >> 5) * 17u;
  else
    rowBytes = (p.nin >> 8) * 210u;
  for (uint ob = gl_WorkGroupID.x * 4u; ob < p.nout; ob += gl_NumWorkGroups.x * 4u)
  {
    uint o = ob + group;
    float acc[ROWS];
    for (uint r = 0u; r < uint(ROWS); r++)
      acc[r] = 0.0;
    if (o < p.nout)
      for (uint e = lane * 8u; e < p.nin; e += 256u)
      {
        float wv[8];
        weights8(wbase + o * rowBytes, e, wv);
        for (uint r = 0u; r < nr; r++)
        {
          uint xi = ((xrow + r) * p.nin + e) >> 2;
          vec4 xa = x[xi];
          vec4 xb = x[xi + 1u];
          acc[r] += wv[0] * xa.x + wv[1] * xa.y + wv[2] * xa.z + wv[3] * xa.w +
                    wv[4] * xb.x + wv[5] * xb.y + wv[6] * xb.z + wv[7] * xb.w;
        }
      }
#ifdef SUBGROUP
    if (sg)
    {
      // 32 partial sums per feature and row: one cluster of 32 invocations
      // (nr is the same for the whole work group: uniform control flow)
      float b = 0.0;
      if ((p.hasBias != 0u) && (o < p.nout))
        b = bias[biasAt(o)];
      for (uint r = 0u; r < nr; r++)
      {
        float v = subgroupClusteredAdd(acc[r], 32u);
        if ((lane == 0u) && (o < p.nout))
          y[(r0 + r) * p.nout + o] = v + b;
      }
    }
    else
#endif
    {
      for (uint r = 0u; r < uint(ROWS); r++)
        partial[r * 128u + t] = acc[r];
      barrier();
      // 32 partial sums per feature and row
      for (uint h = 16u; h > 0u; h >>= 1)
      {
        if (lane < h)
          for (uint r = 0u; r < nr; r++)
            partial[r * 128u + t] += partial[r * 128u + t + h];
        barrier();
      }
      if ((lane == 0u) && (o < p.nout))
      {
        float b = 0.0;
        if (p.hasBias != 0u)
          b = bias[biasAt(o)];
        for (uint r = 0u; r < nr; r++)
          y[(r0 + r) * p.nout + o] = partial[r * 128u + t] + b;
      }
      barrier(); // partial[] is reused for the next features
    }
  }
}
