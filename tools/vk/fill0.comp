// LandrixAI - y[i] = 0 for i < n: the output of a mixture of experts before
// its experts add into it (phase D of docs/native-inference.md, slice D3)
#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) writeonly buffer BufY { float y[]; };

layout(push_constant) uniform Push { uint n; } p;

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i < p.n)
    y[i] = 0.0;
}
