// LandrixAI - dst[r] = src[idx[first + r]], rows of cols floats, one work
// group per gathered row: the token rows of one expert of a mixture of experts
// (phase D of docs/native-inference.md, slice D3; gatherrows of
// tools/cuda/ops.cu)
#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer BufS { float src[]; };
layout(std430, binding = 1) readonly buffer BufI { int idx[]; };
layout(std430, binding = 2) writeonly buffer BufD { float dst[]; };

// first: where the rows of this expert start in idx (an index, not a binding
// offset: those must be multiples of minStorageBufferOffsetAlignment)
layout(push_constant) uniform Push { uint cols; uint first; } p;

void main()
{
  uint r = gl_WorkGroupID.x;
  uint s = uint(idx[p.first + r]) * p.cols;
  uint d = r * p.cols;
  for (uint c = gl_LocalInvocationID.x; c < p.cols; c += 128u)
    dst[d + c] = src[s + c];
}
