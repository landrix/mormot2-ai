// LandrixAI - the query projection of an attention with an output gate
// (Qwen3.5, phase D slice D7e2) holds per head its query, then its gate: q and
// g get them apart, n heads of d values each, one invocation per value
#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer BufQG { float qg[]; };
layout(std430, binding = 1) writeonly buffer BufQ { float q[]; };
layout(std430, binding = 2) writeonly buffer BufG { float g[]; };

layout(push_constant) uniform Push {
  uint n, d;
} p;

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i >= p.n * p.d)
    return;
  uint r = i / p.d;
  uint c = i - r * p.d;
  q[i] = qg[r * 2u * p.d + c];
  g[i] = qg[r * 2u * p.d + p.d + c];
}
