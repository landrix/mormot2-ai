// LandrixAI - a[i] *= sigmoid(g[i]) over n values: the output gate of an
// attention (Qwen3.5, phase D slice D7e2; GateBySigmoid on the CPU)
#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer BufA { float a[]; };
layout(std430, binding = 1) readonly buffer BufG { float g[]; };

layout(push_constant) uniform Push { uint n; } p;

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i < p.n)
  {
    float x = g[i];
    a[i] = a[i] * (x < -100.0 ? 0.0 : 1.0 / (1.0 + exp(-x)));
  }
}
